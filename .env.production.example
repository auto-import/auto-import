# Copy to .env.production on the deployment host. Never commit the populated file.
APP_DOMAIN=erp.example.invalid
CORS_ORIGIN=https://erp.example.invalid
PUBLIC_API_BASE_URL=https://erp.example.invalid/api
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY_HOPS=1

# Container-private absolute path. Keep it aligned with the private_documents volume.
PRIVATE_STORAGE_ROOT=/app/storage/private
# Upload limits are enforced in application code: logo 2 MiB, avatar 5 MiB,
# evidence/photo 8 MiB and general/passport documents 25 MiB. Nginx allows 30 MiB
# for multipart overhead; lower limits remain enforced per endpoint.

POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://replace_with_url_encoded_user:replace_with_url_encoded_password@postgres:5432/replace_with_database_name
REDIS_PASSWORD=replace_with_random_redis_password

# Generate each value independently: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_random_value
PII_ENCRYPTION_KEY=replace_with_random_value
PII_LOOKUP_HMAC_KEY=replace_with_random_value
INTEGRATION_SECRETS_ENCRYPTION_KEY=replace_with_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Optional integrations remain disabled until a real provider adapter is selected.
TELEPHONY_PROVIDER=disabled
TELEPHONY_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=disabled
WHATSAPP_APP_SECRET=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Backup scripts read these values without embedding credentials in source.
BACKUP_ROOT=/srv/auto-import/backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=replace_with_operations_public_key_fingerprint
BACKUP_OFFSITE_COMMAND=
