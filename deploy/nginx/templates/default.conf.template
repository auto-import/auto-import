limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream frontend_upstream { server frontend:3001; keepalive 16; }
upstream backend_upstream { server backend:3000; keepalive 32; }

server {
  listen 80;
  listen [::]:80;
  server_name ${APP_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    try_files $uri =404;
  }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${APP_DOMAIN};
  server_tokens off;

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # Backend endpoints enforce their narrower per-file limits (2/5/8/25 MiB).
  client_max_body_size 30m;
  autoindex off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

  location ~* /(?:\.env|\.git|backups?|dumps?|storage/private)(?:/|$) { deny all; }
  location = /api/docs { deny all; }
  location ^~ /api/docs/ { deny all; }

  location = /health {
    proxy_pass http://backend_upstream;
    include /etc/nginx/proxy_params;
  }

  location = /ping {
    proxy_pass http://backend_upstream;
    include /etc/nginx/proxy_params;
  }

  location = /api/auth/login {
    limit_req zone=auth_limit burst=5 nodelay;
    proxy_pass http://backend_upstream;
    include /etc/nginx/proxy_params;
  }

  location /api/ {
    proxy_pass http://backend_upstream;
    include /etc/nginx/proxy_params;
    proxy_read_timeout 60s;
  }

  location /socket.io/ {
    proxy_pass http://backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 75s;
    proxy_buffering off;
  }

  location / {
    proxy_pass http://frontend_upstream;
    include /etc/nginx/proxy_params;
    proxy_read_timeout 60s;
  }
}
