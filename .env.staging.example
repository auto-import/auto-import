# Copy to .env.staging on the test VPS. Never commit the populated file.
APP_DOMAIN=203.0.113.10
CORS_ORIGIN=http://203.0.113.10
PUBLIC_API_BASE_URL=http://203.0.113.10/api
HTTP_PORT=80
TRUST_PROXY_HOPS=1
PRIVATE_STORAGE_ROOT=/app/storage/private
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://replace_with_url_encoded_user:replace_with_url_encoded_password@postgres:5432/auto_import
REDIS_PASSWORD=replace_with_random_database_password
JWT_ACCESS_SECRET=replace_with_random_value_of_at_least_32_characters
PII_ENCRYPTION_KEY=replace_with_random_value_of_at_least_32_characters
PII_LOOKUP_HMAC_KEY=replace_with_random_value_of_at_least_32_characters
INTEGRATION_SECRETS_ENCRYPTION_KEY=replace_with_random_value_of_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
