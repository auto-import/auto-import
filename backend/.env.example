DATABASE_URL=postgresql://auto_import:change_me@localhost:5432/auto_import
SHADOW_DATABASE_URL=postgresql://auto_import:change_me@localhost:5432/auto_import_shadow
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
PII_ENCRYPTION_KEY=replace_with_at_least_32_random_bytes
PII_LOOKUP_HMAC_KEY=replace_with_a_distinct_32_byte_random_secret
INTEGRATION_SECRETS_ENCRYPTION_KEY=replace_with_a_distinct_32_byte_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:3000/api
TRUST_PROXY_HOPS=1
PRIVATE_STORAGE_ROOT=C:\absolute\path\auto-import-private-storage
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_for_local_seed_only
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_API_BASE_URL=
TELEPHONY_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PUBLIC_WEBHOOK_BASE_URL=

# Document Encryption at Rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to disable encryption (existing plaintext files remain readable).
DOCUMENT_ENCRYPTION_KEY=

# Demo data: only use a brand-new local disposable database and storage folder.
# The database name must begin with codex_demo_ and the absolute storage folder
# name must begin with .codex-demo-storage-. Never copy a real password here.
ALLOW_DEMO_SEED=false
DEMO_SEED_SCALE=small
DEMO_SEED_ANCHOR_DATE=2026-08-25T12:00:00.000Z
DEMO_SEED_PASSWORD=
DEMO_FILE_STORAGE_ROOT=C:\absolute\path\.codex-demo-storage-local
