model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String?
  country        String?
  city           String?
  address        String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  locations WarehouseLocation[]

  @@index([organizationId, status])
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  name        String?
  status      String    @default("active")

  vehicles      Vehicle[]
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo   StockMovement[] @relation("StockMovementTo")

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
}

model StockMovement {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id])
  fromLocationId String?
  fromLocation   WarehouseLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     WarehouseLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id])
  performedBy    String
  user           User               @relation(fields: [performedBy], references: [id])
  type           String
  reason         String?
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())

  @@index([organizationId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedBy])
}

// ──────────────────────────────────────────────
// Request & Order Models
// ──────────────────────────────────────────────

model VehicleRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  assignedTo     String?
  assignee       User?        @relation(fields: [assignedTo], references: [id])
  brand          String?
  model          String?
  minYear        Int?
  maxYear        Int?
  budgetMin      Decimal?     @db.Decimal(12, 2)
  budgetMax      Decimal?     @db.Decimal(12, 2)
  currency       String?
  preferredColor String?
  requirements   String?
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidates VehicleCandidate[]
  dossier    Dossier?
  purchase   Purchase?

  @@index([organizationId, status, createdAt])
  @@index([prospectId])
  @@index([clientId])
  @@index([assignedTo])
}

model VehicleCandidate {
  id               String         @id @default(uuid())
  vehicleRequestId String
  vehicleRequest   VehicleRequest @relation(fields: [vehicleRequestId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  proposedPrice    Decimal?       @db.Decimal(12, 2)
  currency         String?
  status           String         @default("proposed") // proposed | validated | rejected
  notes            String?
  presentedAt      DateTime?
  validatedAt      DateTime?
  purchase         Purchase?

  @@unique([vehicleRequestId, vehicleId])
  @@index([vehicleId])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNumber    String
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  createdBy      String
  creator        User         @relation(fields: [createdBy], references: [id])
  status         String       @default("draft")
  subtotal       Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  currency       String
  orderDate      DateTime     @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items            OrderItem[]
  history          OrderStatusHistory[]
  reservations     Reservation[]
  dossier          Dossier?
  invoices         Invoice[]
  paymentPlans     PaymentPlan[]
  deposits         CustomerDeposit[]
  shipmentVehicles ShipmentVehicle[]
  purchases        Purchase[]
  payments         Payment[]
  costs            Cost[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, orderDate])
  @@index([clientId])
  @@index([prospectId])
  @@index([createdBy])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  invoiceItems InvoiceItem[]

  @@index([vehicleId])
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  changedBy  String
  user       User     @relation(fields: [changedBy], references: [id])
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedBy])
}

model Reservation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  reservedBy     String
  user           User         @relation(fields: [reservedBy], references: [id])
  status         String       @default("active")
  reservedAt     DateTime     @default(now())
  expiresAt      DateTime?
  releasedAt     DateTime?
  releaseReason  String?

  @@index([organizationId, status, expiresAt])
  @@index([vehicleId, status])
  @@index([orderId])
  @@index([reservedBy])
}

// ──────────────────────────────────────────────
// Procurement, Shipping & Customs Models
// ──────────────────────────────────────────────

model Purchase {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id])
  purchaseNumber        String
  supplierId            String
  supplier              Partner             @relation(fields: [supplierId], references: [id])
  vehicleId             String
  vehicle               Vehicle             @relation(fields: [vehicleId], references: [id])
  purchasePrice         Decimal             @db.Decimal(12, 2)
  currency              String
  status                String              @default("pending")
  purchaseDate          DateTime?
  vehicleRequestId      String?             @unique
  vehicleRequest        VehicleRequest?     @relation(fields: [vehicleRequestId], references: [id])
  candidateId           String?             @unique
  candidate             VehicleCandidate?   @relation(fields: [candidateId], references: [id])
  dossierId             String?
  dossier               Dossier?            @relation(fields: [dossierId], references: [id])
  orderId               String?
  order                 Order?              @relation(fields: [orderId], references: [id])
  confirmedBy           String?
  confirmer             User?               @relation("PurchaseConfirmer", fields: [confirmedBy], references: [id])
  supplierSnapshot      Json?
  vehicleSnapshot       Json?
  offerReservationId    String?             @unique
  offerReservation      OfferReservation?   @relation(fields: [offerReservationId], references: [id])
  sourceOfferId         String?
  sourceOffer           ChinaOffer?         @relation("PurchaseSourceOffer", fields: [sourceOfferId], references: [id], onDelete: Restrict)
  sourceOfferRevisionId String?
  sourceOfferRevision   ChinaOfferRevision? @relation(fields: [sourceOfferRevisionId], references: [id], onDelete: Restrict)
  sourceOfferVehicleId  String?
  sourceOfferVehicle    ChinaOfferVehicle?  @relation(fields: [sourceOfferVehicleId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  payments            SupplierPayment[]
  costs               Cost[]
  gedLinks            GedDocumentLink[]
  financeTransactions FinanceTransaction[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, status, purchaseDate])
  @@index([supplierId])
  @@index([vehicleId])
  @@index([dossierId])
  @@index([orderId])
  @@index([sourceOfferId])
  @@index([sourceOfferRevisionId])
  @@index([sourceOfferVehicleId])
}

model SupplierPayment {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  supplierId     String
  supplier       Partner       @relation(fields: [supplierId], references: [id])
  purchaseId     String
  purchase       Purchase      @relation(fields: [purchaseId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  paymentKind    String        @default("COMPLEMENT")
  currency       String
  paymentMethod  String?
  reference      String?
  idempotencyKey String?
  status         String        @default("pending")
  paymentDate    DateTime?
  paidAt         DateTime?
  confirmedAt    DateTime?
  reversedAt     DateTime?
  reversalReason String?
  actorUserId    String?
  actorUser      User?         @relation("SupplierPaymentActor", fields: [actorUserId], references: [id])
  exchangeRateId String?
  exchangeRate   ExchangeRate? @relation(fields: [exchangeRateId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  financeTransaction FinanceTransaction?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, paymentDate])
  @@index([purchaseId])
  @@index([supplierId])
}

model Shipment {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  shipmentNumber      String
  carrierPartnerId    String?
  carrierPartner      Partner?     @relation(fields: [carrierPartnerId], references: [id])
  blNumber            String?
  vesselName          String?
  containerNumber     String?
  departurePort       String?
  arrivalPort         String?
  etd                 DateTime?
  eta                 DateTime?
  actualDepartureDate DateTime?
  actualArrivalDate   DateTime?
  status              String       @default("pending")
  notes               String?
  containerPresetId   String?
  containerPreset     ContainerPreset? @relation(fields: [containerPresetId], references: [id], onDelete: Restrict)
  totalFreightCost    Decimal?          @db.Decimal(12, 2)
  freightCurrency     String?
  capacityVolumeM3    Decimal?          @db.Decimal(12, 3)
  capacityWeightKg    Decimal?          @db.Decimal(12, 2)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  vehicles      ShipmentVehicle[]
  costs         Cost[]
  shippingCosts ShippingCost[]
  customsFiles  CustomsFile[]
  statusHistory ShipmentStatusHistory[]
  gedLinks      GedDocumentLink[]
  documents     DossierDocumentAsset[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId, status, etd])
  @@index([carrierPartnerId])
  @@index([containerPresetId])
}

model ContainerPreset {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  label               String
  internalLengthCm    Decimal      @db.Decimal(10, 2)
  internalWidthCm     Decimal      @db.Decimal(10, 2)
  internalHeightCm    Decimal      @db.Decimal(10, 2)
  maxVolumeM3         Decimal      @db.Decimal(10, 3)
  maxPayloadKg        Decimal      @db.Decimal(12, 2)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  shipments           Shipment[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model ShipmentStatusHistory {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String
  user       User     @relation("ShipmentStatusUser", fields: [changedBy], references: [id])
  comment    String?
  createdAt  DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([changedBy])
}

model ShipmentVehicle {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  capacityOverride Boolean @default(false)
  overrideReason   String?
  addedBy          String?
  addedAt          DateTime @default(now())

  @@unique([shipmentId, vehicleId])
  @@index([vehicleId])
  @@index([orderId])
}

model ShippingCost {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  description String?
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

model CustomsFile {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  reference              String
  shipmentId             String?
  shipment               Shipment?    @relation(fields: [shipmentId], references: [id])
  vehicleId              String?
  vehicle                Vehicle?     @relation(fields: [vehicleId], references: [id])
  dossierId              String?
  dossier                Dossier?     @relation(fields: [dossierId], references: [id])
  brokerPartnerId        String?
  brokerPartner          Partner?     @relation("CustomsBroker", fields: [brokerPartnerId], references: [id])
  responsibleUserId      String?
  responsibleUser        User?        @relation("CustomsResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  status                 String       @default("open")
  v2Status               String?
  reconciliationRequired Boolean      @default(false)
  declarationNumber      String?
  containerSnapshot      String?
  blSnapshot             String?
  arrivalPortSnapshot    String?
  customsValue           Decimal?     @db.Decimal(12, 2)
  customsAmount          Decimal?     @db.Decimal(12, 2)
  dutyAmount             Decimal?     @db.Decimal(12, 2)
  taxAmount              Decimal?     @db.Decimal(12, 2)
  feesAmount             Decimal?     @db.Decimal(12, 2)
  currency               String?
  openedAt               DateTime     @default(now())
  closedAt               DateTime?
  clearedAt              DateTime?
  releasedAt             DateTime?
  portExitAt             DateTime?
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  documents     CustomsDocument[]
  costs         Cost[]
  statusHistory CustomsStatusHistory[]
  gedLinks      GedDocumentLink[]
  vehicles      CustomsFileVehicle[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, openedAt])
  @@index([shipmentId])
  @@index([vehicleId])
  @@index([dossierId])
  @@index([organizationId, v2Status, openedAt])
  @@index([responsibleUserId, v2Status])
}

model CustomsFileVehicle {
  id            String      @id @default(uuid())
  customsFileId String
  customsFile   CustomsFile @relation(fields: [customsFileId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([customsFileId, vehicleId])
  @@index([vehicleId])
}

model CustomsStatusHistory {
  id            String      @id @default(uuid())
  customsFileId String
  customsFile   CustomsFile @relation(fields: [customsFileId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  changedBy     String
  user          User        @relation("CustomsStatusUser", fields: [changedBy], references: [id])
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([customsFileId, createdAt])
  @@index([changedBy])
}

model CustomsDocument {
  id            String      @id @default(uuid())
  customsFileId String
  customsFile   CustomsFile @relation(fields: [customsFileId], references: [id])
  fileId        String
  file          FileAsset   @relation(fields: [fileId], references: [id])
  documentType  String?
  status        String      @default("pending")
  uploadedAt    DateTime    @default(now())

  @@index([customsFileId])
  @@index([fileId])
}

model BusinessDocument {
  id           String    @id @default(uuid())
  fileId       String
  file         FileAsset @relation(fields: [fileId], references: [id])
  uploadedBy   String
  user         User      @relation(fields: [uploadedBy], references: [id])
  documentType String?
  title        String?
  description  String?
  entityType   String // "dossier" | "client" | "vehicle" ...
  entityId     String
  createdAt    DateTime  @default(now())

  @@index([uploadedBy, createdAt])
  @@index([entityType, entityId])
}

model DossierDocumentAsset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  dossierId      String?
  dossier        Dossier?     @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fileId         String?
  file           FileAsset?   @relation(fields: [fileId], references: [id])
  externalUrl    String?
  shipmentId     String?
  shipment       Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  gedDocumentId  String?      @unique
  gedDocument    GedDocument? @relation(fields: [gedDocumentId], references: [id], onDelete: SetNull)
  kind           String // "DOSSIER_DOCUMENT" | "PROOF" | "CONTRACT" | "CUSTOMS_DOCUMENT" | "PAYMENT_RECEIPT" | "VEHICLE_PHOTO" | "BUSINESS_DOCUMENT"
  documentType   String? // "id_client", "contrat", "pi_fournisseur", "facture_fournisseur", "preuve_paiement", "rapport_inspection", "bl_draft", "bl_final", "documents_douane", "document_livraison"
  title          String?
  description    String?
  status         String       @default("valid") // "pending" | "valid" | "rejected" | "archived"
  uploadedBy     String
  uploadedByUser User         @relation("DossierDocUploader", fields: [uploadedBy], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, dossierId, kind, status])
  @@index([fileId])
  @@index([dossierId, documentType])
  @@index([organizationId, clientId, createdAt])
  @@index([shipmentId, documentType])
}

// Central GED metadata. FileAsset remains the sole physical blob authority.
model GedCategory {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  labelFr            String
  description        String?
  defaultSensitivity String       @default("INTERNAL")
  active             Boolean      @default(true)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  types     GedDocumentType[]
  documents GedDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, active, sortOrder])
}

model GedDocumentType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       GedCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code           String
  labelFr        String
  description    String?
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  documents      GedDocument[]
  checklistRules DossierChecklistRule[]

  @@unique([organizationId, code])
  @@index([organizationId, categoryId, active, sortOrder])
}

model GedDocument {
  id               String              @id @default(uuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         GedCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  documentTypeId   String?
  documentType     GedDocumentType?    @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  validationStatus String              @default("TO_VALIDATE")
  sensitivity      String              @default("INTERNAL")
  currentVersionId String?             @unique
  currentVersion   GedDocumentVersion? @relation("GedCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  createdBy        String
  creator          User                @relation("GedDocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt       DateTime?
  archivedById     String?
  archivedBy       User?               @relation("GedDocumentArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  archiveReason    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  versions             GedDocumentVersion[]   @relation("GedVersions")
  links                GedDocumentLink[]
  validationHistory    GedValidationHistory[]
  legacyDossierRecords DossierDocumentAsset[]
  signedContracts      Contract[]             @relation("ContractSignedDocument")
  financeTransactions  FinanceTransaction[]   @relation("FinanceSupportingDocument")

  @@index([organizationId, validationStatus, expiryDate])
  @@index([organizationId, sensitivity, createdAt])
  @@index([categoryId])
  @@index([documentTypeId])
  @@index([archivedById])
}

model GedDocumentVersion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       GedDocument  @relation("GedVersions", fields: [documentId], references: [id], onDelete: Restrict)
  fileId         String
  file           FileAsset    @relation(fields: [fileId], references: [id], onDelete: Restrict)
  versionNumber  Int
  checksum       String
  changeReason   String?
  uploadedBy     String
  uploader       User         @relation("GedVersionUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  currentFor GedDocument? @relation("GedCurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([organizationId, createdAt])
  @@index([fileId])
}

model GedValidationHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       GedDocument  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  fromStatus     String?
  toStatus       String
  reason         String?
  actorId        String
  actor          User         @relation("GedValidationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([organizationId, documentId, createdAt])
  @@index([actorId, createdAt])
}

model DossierChecklistRule {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentTypeId    String
  documentType      GedDocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  dossierType       String?
  workflowStatus    String?
  required          Boolean         @default(true)
  blocking          Boolean         @default(false)
  expiryWarningDays Int             @default(30)
  active            Boolean         @default(true)
  createdBy         String
  creator           User            @relation("ChecklistRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, documentTypeId, dossierType, workflowStatus], map: "DossierChecklistRule_scope_key")
  @@index([organizationId, active, dossierType, workflowStatus], map: "DossierChecklistRule_scope_lookup_idx")
}

// Explicit optional foreign keys retain database referential integrity. A migration
// CHECK constraint enforces exactly one target for every active or archived link.
model GedDocumentLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       GedDocument  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossierId      String?
  dossier        Dossier?     @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  supplierId     String?
  supplier       Partner?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  chinaOfferId   String?
  chinaOffer     ChinaOffer?  @relation(fields: [chinaOfferId], references: [id], onDelete: Restrict)
  purchaseId     String?
  purchase       Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  shipmentId     String?
  shipment       Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customsFileId  String?
  customsFile    CustomsFile? @relation(fields: [customsFileId], references: [id], onDelete: Restrict)
  paymentId      String?
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract?    @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy      String
  creator        User         @relation("GedLinkCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  archivedAt     DateTime?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  prospectId     String?

  @@index([organizationId, documentId, archivedAt])
  @@index([clientId])
  @@index([dossierId])
  @@index([vehicleId])
  @@index([supplierId])
  @@index([chinaOfferId])
  @@index([purchaseId])
  @@index([shipmentId])
  @@index([customsFileId])
  @@index([paymentId])
  @@index([contractId])
}

model IntegrationConfig {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind                 String
  providerName         String
  displayName          String?
  baseUrl              String?
  publicIdentifiers    Json?
  encryptedCredentials String?
  encryptionKeyVersion Int          @default(1)
  enabled              Boolean      @default(false)
  webhookLastEventAt   DateTime?
  webhookLastStatus    String?
  updatedBy            String
  updatedByUser        User         @relation("IntegrationConfigUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, kind])
  @@index([organizationId, enabled])
}

model DossierNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("DossierNoteAuthor", fields: [authorId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([organizationId, dossierId, createdAt])
}

// ──────────────────────────────────────────────
// Finance Models
// ──────────────────────────────────────────────

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNumber  String
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  dossierId      String?
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  status         String       @default("DRAFT")
  subtotal       Decimal      @db.Decimal(12, 2)
  tax            Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  paidAmount     Decimal      @default(0) @db.Decimal(12, 2)
  currency       String
  issueDate      DateTime?
  dueDate        DateTime?
  voidedAt       DateTime?
  voidReason     String?
  notes          String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items       InvoiceItem[]
  payments    Payment[]
  allocations PaymentAllocation[]
  contracts   Contract[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, issueDate])
  @@index([clientId])
  @@index([orderId])
  @@index([dossierId])
}

model InvoiceItem {
  id           String     @id @default(uuid())
  invoiceId    String
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItemId  String?
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id])
  description  String?
  quantity     Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
  tax          Decimal    @default(0) @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  sourceEntity String?
  createdAt    DateTime   @default(now())

  @@index([invoiceId])
  @@index([orderItemId])
}

model PaymentPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  dossierId      String?
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  strategy       String       @default("THIRTY_SEVENTY")
  totalAmount    Decimal      @db.Decimal(12, 2)
  currency       String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  installments PaymentInstallment[]

  @@index([organizationId, status])
  @@index([dossierId])
  @@index([orderId])
  @@index([clientId])
}

model PaymentInstallment {
  id                String      @id @default(uuid())
  paymentPlanId     String
  paymentPlan       PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  label             String?
  percentage        Decimal     @default(0) @db.Decimal(5, 2)
  amount            Decimal     @db.Decimal(12, 2)
  paidAmount        Decimal     @default(0) @db.Decimal(12, 2)
  dueTrigger        String      @default("ON_PLAN_CREATION")
  dueDate           DateTime?
  status            String      @default("PENDING")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  payments    Payment[]
  allocations PaymentAllocation[]

  @@unique([paymentPlanId, installmentNumber])
  @@index([status, dueDate])
}

model Payment {
  id                String              @id @default(uuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id])
  dossierId         String?
  dossier           Dossier?            @relation(fields: [dossierId], references: [id])
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id])
  invoiceId         String?
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id])
  installmentId     String?
  installment       PaymentInstallment? @relation(fields: [installmentId], references: [id])
  amount            Decimal             @db.Decimal(12, 2)
  allocatedAmount   Decimal             @default(0) @db.Decimal(12, 2)
  unallocatedAmount Decimal             @default(0) @db.Decimal(12, 2)
  currency          String
  paymentMethod     String?
  reference         String?
  idempotencyKey    String?
  status            String              @default("PENDING")
  paymentDate       DateTime?
  receivedAt        DateTime?           @default(now())
  confirmedAt       DateTime?
  reversedAt        DateTime?
  reversalReason    String?
  actorUserId       String?
  actorUser         User?               @relation("PaymentActor", fields: [actorUserId], references: [id])
  exchangeRateId    String?
  exchangeRate      ExchangeRate?       @relation(fields: [exchangeRateId], references: [id])
  notes             String?
  contractId        String?
  contract          Contract?           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  allocations        PaymentAllocation[]
  deposit            CustomerDeposit?
  gedLinks           GedDocumentLink[]
  financeTransaction FinanceTransaction?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, paymentDate])
  @@index([clientId])
  @@index([dossierId])
  @@index([orderId])
  @@index([invoiceId])
  @@index([installmentId])
  @@index([contractId])
}

model PaymentAllocation {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  paymentId      String
  payment        Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])
  installmentId  String?
  installment    PaymentInstallment? @relation(fields: [installmentId], references: [id])
  amount         Decimal             @db.Decimal(12, 2)
  allocatedAt    DateTime            @default(now())
  reversedAt     DateTime?
  status         String              @default("ACTIVE")

  @@index([paymentId])
  @@index([invoiceId])
  @@index([installmentId])
  @@index([organizationId, status])
}

model CustomerDeposit {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  prospectId      String?
  prospect        Prospect?    @relation(fields: [prospectId], references: [id])
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  dossierId       String?
  dossier         Dossier?     @relation(fields: [dossierId], references: [id])
  orderId         String?
  order           Order?       @relation(fields: [orderId], references: [id])
  paymentId       String?      @unique
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  appliedAmount   Decimal      @default(0) @db.Decimal(12, 2)
  unappliedAmount Decimal      @db.Decimal(12, 2)
  currency        String
  paymentMethod   String?
  reference       String?
  status          String       @default("CONFIRMED")
  paymentDate     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([prospectId])
  @@index([clientId])
  @@index([dossierId])
  @@index([orderId])
}

model ExchangeRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  baseCurrency   String
  quoteCurrency  String
  rate           Decimal      @db.Decimal(18, 8)
  effectiveAt    DateTime     @default(now())
  source         String?
  notes          String?
  createdById    String?
  createdBy      User?        @relation("ExchangeRateCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  payments         Payment[]
  supplierPayments SupplierPayment[]
  costs            Cost[]

  @@index([organizationId, baseCurrency, quoteCurrency, effectiveAt])
}

model Cost {
  id                   String        @id @default(uuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id])
  type                 String
  costScope            String        @default("DIRECT")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String
  exchangeRateId       String?
  exchangeRate         ExchangeRate? @relation(fields: [exchangeRateId], references: [id])
  amountInBaseCurrency Decimal?      @db.Decimal(12, 2)
  dossierId            String?
  dossier              Dossier?      @relation(fields: [dossierId], references: [id])
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id])
  purchaseId           String?
  purchase             Purchase?     @relation(fields: [purchaseId], references: [id])
  shipmentId           String?
  shipment             Shipment?     @relation(fields: [shipmentId], references: [id])
  customsFileId        String?
  customsFile          CustomsFile?  @relation(fields: [customsFileId], references: [id])
  occurredAt           DateTime      @default(now())
  description          String?
  actorUserId          String?
  actorUser            User?         @relation("CostActor", fields: [actorUserId], references: [id])
  status               String        @default("POSTED")
  reversedAt           DateTime?
  reversalReason       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  financeTransaction FinanceTransaction?

  @@index([organizationId, type, status])
  @@index([dossierId])
  @@index([orderId])
  @@index([purchaseId])
  @@index([shipmentId])
  @@index([customsFileId])
  @@index([organizationId, costScope, status, occurredAt])
}

/// Signed customer commitment. Collected and outstanding amounts are always
/// derived from validated Payment rows, never stored as editable totals.
model Contract {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contractNumber   String
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  dossierId        String
  dossier          Dossier      @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  totalAmount      Decimal      @db.Decimal(14, 2)
  currency         String
  requiredDeposit  Decimal      @default(0) @db.Decimal(14, 2)
  status           String       @default("DRAFT")
  signedAt         DateTime?
  signedDocumentId String?
  signedDocument   GedDocument? @relation("ContractSignedDocument", fields: [signedDocumentId], references: [id], onDelete: Restrict)
  invoiceId        String?
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy        String
  creator          User         @relation("ContractCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  schedule   ContractScheduleItem[]
  payments   Payment[]
  gedLinks   GedDocumentLink[]
  prospect   Prospect?              @relation(fields: [prospectId], references: [id])
  prospectId String?

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status, signedAt])
  @@index([dossierId, createdAt])
  @@index([clientId, createdAt])
  @@index([invoiceId])
}

model ContractScheduleItem {
  id         String    @id @default(uuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  sequence   Int
  label      String?
  amount     Decimal   @db.Decimal(14, 2)
  dueDate    DateTime?
  createdAt  DateTime  @default(now())

  @@unique([contractId, sequence])
  @@index([dueDate])
}

/// Customer-facing CIF/DDP pricing. Supplier offer prices never live here and
/// customer prices never live on ChinaOffer. Every price change is append-only.
model CustomerQuotation {
  id                    String                     @id @default(uuid())
  organizationId        String
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotationNumber       String
  dossierId             String
  dossier               Dossier                    @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  clientId              String
  client                Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceOfferId         String?
  sourceOffer           ChinaOffer?                @relation(fields: [sourceOfferId], references: [id], onDelete: Restrict)
  sourceOfferRevisionId String?
  sourceOfferRevision   ChinaOfferRevision?        @relation(fields: [sourceOfferRevisionId], references: [id], onDelete: Restrict)
  priceBasis            String
  currency              String
  status                String                     @default("DRAFT")
  currentRevisionId     String?                    @unique
  currentRevision       CustomerQuotationRevision? @relation("CustomerQuotationCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  expiresAt             DateTime?
  sentAt                DateTime?
  acceptedAt            DateTime?
  createdBy             String
  creator               User                       @relation("CustomerQuotationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  revisions CustomerQuotationRevision[] @relation("CustomerQuotationRevisions")

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, status, createdAt])
  @@index([dossierId, createdAt])
  @@index([clientId, createdAt])
  @@index([sourceOfferId])
}

model CustomerQuotationRevision {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotationId        String
  quotation          CustomerQuotation @relation("CustomerQuotationRevisions", fields: [quotationId], references: [id], onDelete: Restrict)
  revisionNumber     Int
  vehicleAmount      Decimal           @default(0) @db.Decimal(14, 2)
  freightAmount      Decimal           @default(0) @db.Decimal(14, 2)
  insuranceAmount    Decimal           @default(0) @db.Decimal(14, 2)
  customsAmount      Decimal           @default(0) @db.Decimal(14, 2)
  transitAmount      Decimal           @default(0) @db.Decimal(14, 2)
  otherCostsAmount   Decimal           @default(0) @db.Decimal(14, 2)
  marginAmount       Decimal           @default(0) @db.Decimal(14, 2)
  finalCustomerPrice Decimal           @db.Decimal(14, 2)
  paymentConditions  String?
  validityNote       String?
  notes              String?
  reason             String
  snapshot           Json
  createdBy          String
  creator            User              @relation("CustomerQuotationRevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())

  currentFor CustomerQuotation? @relation("CustomerQuotationCurrentRevision")

  @@unique([quotationId, revisionNumber])
  @@index([organizationId, quotationId, createdAt])
}

model TreasuryAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  name           String
  type           String
  currency       String
  status         String       @default("ACTIVE")
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  openedAt       DateTime     @default(now())
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions FinanceTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, status, currency])
}

/// Immutable, source-linked central financial movement. Validated entries are
/// corrected only through a linked reversal; exchange-rate snapshots never move.
model FinanceTransaction {
  id                   String               @id @default(uuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type                 String
  direction            String
  sourceModule         String
  sourceRecordId       String
  idempotencyKey       String?
  originalAmount       Decimal              @db.Decimal(14, 2)
  currency             String
  exchangeRateSnapshot Decimal              @db.Decimal(18, 8)
  amountDzd            Decimal              @db.Decimal(14, 2)
  dossierId            String?
  dossier              Dossier?             @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  clientId             String?
  client               Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supplierId           String?
  supplier             Partner?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasuryAccountId    String?
  treasuryAccount      TreasuryAccount?     @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  paymentMode          String?
  reference            String?
  supportingDocumentId String?
  supportingDocument   GedDocument?         @relation("FinanceSupportingDocument", fields: [supportingDocumentId], references: [id], onDelete: Restrict)
  customerPaymentId    String?              @unique
  customerPayment      Payment?             @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  supplierPaymentId    String?              @unique
  supplierPayment      SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  costId               String?              @unique
  cost                 Cost?                @relation(fields: [costId], references: [id], onDelete: Restrict)
  purchaseId           String?
  purchase             Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  status               String               @default("PENDING")
  createdBy            String
  creator              User                 @relation("FinanceTransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  validatedBy          String?
  validator            User?                @relation("FinanceTransactionValidator", fields: [validatedBy], references: [id], onDelete: Restrict)
  occurredAt           DateTime             @default(now())
  validatedAt          DateTime?
  reversalOfId         String?
  reversalOf           FinanceTransaction?  @relation("FinanceReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals            FinanceTransaction[] @relation("FinanceReversal")
  reversalReason       String?
  createdAt            DateTime             @default(now())
  prospect             Prospect?            @relation(fields: [prospectId], references: [id])
  prospectId           String?

  @@unique([organizationId, sourceModule, sourceRecordId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, type, occurredAt])
  @@index([treasuryAccountId, status, occurredAt])
  @@index([dossierId, status, occurredAt])
  @@index([clientId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([reversalOfId])
}

// ──────────────────────────────────────────────
// Support & Operations Models
// ──────────────────────────────────────────────

model Task {
