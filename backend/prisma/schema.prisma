  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, supplierId, status, occurredAt])
}

model SupplierDossierLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Partner      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  dossierId      String
  dossier        Dossier      @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  source         String
  createdBy      String
  creator        User         @relation("SupplierDossierLinkCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([supplierId, dossierId])
  @@index([organizationId, dossierId])
}

model CommerceSequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

model ChinaOffer {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  supplierId         String
  supplier           Partner             @relation(fields: [supplierId], references: [id])
  reference          String
  brand              String
  model              String
  version            String?
  year               Int?
  condition          String
  mileage            Int?
  specification      Json
  purchasePrice      Decimal?            @db.Decimal(12, 2)
  supplierPrice      Decimal?            @db.Decimal(12, 2)
  cifPrice           Decimal?            @db.Decimal(12, 2)
  ddpPrice           Decimal?            @db.Decimal(12, 2)
  currency           String
  supplierReference  String?
  incoterm           String?
  location           String?
  leadTimeDays       Int?
  paymentConditions  String?
  vin                String?
  offerStatus        String?
  currentRevisionId  String?             @unique
  currentRevision    ChinaOfferRevision? @relation("ChinaOfferCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  validFrom          DateTime
  validUntil         DateTime
  availableQuantity  Int
  reservedQuantity   Int                 @default(0)
  estimatedDelayDays Int?
  status             String              @default("available")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  reservations       OfferReservation[]
  photos             OfferPhoto[]
  gedLinks           GedDocumentLink[]
  revisions          ChinaOfferRevision[]      @relation("ChinaOfferRevisions")
  statusHistory      ChinaOfferStatusHistory[]
  sourcePurchases    Purchase[]                @relation("PurchaseSourceOffer")
  vehicles           ChinaOfferVehicle[]
  customerQuotations CustomerQuotation[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, validUntil])
  @@index([organizationId, supplierId, createdAt])
  @@index([organizationId, offerStatus, validUntil])
}

/// A supplier offer can contain several independently purchasable vehicle
/// lines. The legacy vehicle columns on ChinaOffer remain as a compatible
/// summary of the first line for historical integrations.
model ChinaOfferVehicle {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerId           String
  offer             ChinaOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  lineNumber        Int
  brand             String
  model             String
  version           String?
  year              Int?
  condition         String
  mileage           Int?
  specification     Json
  supplierPrice     Decimal      @db.Decimal(12, 2)
  currency          String
  vin               String?
  quantity          Int          @default(1)
  reservedQuantity  Int          @default(0)
  purchasedQuantity Int          @default(0)
  status            String       @default("RECEIVED")
  lostReason        String?
  purchasedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  purchases Purchase[]

  @@unique([offerId, lineNumber])
  @@index([organizationId, status, createdAt])
  @@index([offerId, status])
  @@index([organizationId, vin])
}

model ChinaOfferRevision {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerId           String
  offer             ChinaOffer   @relation("ChinaOfferRevisions", fields: [offerId], references: [id], onDelete: Restrict)
  revisionNumber    Int
  supplierPrice     Decimal      @db.Decimal(12, 2)
  currency          String
  incoterm          String?
  location          String?
  quantity          Int
  leadTimeDays      Int?
  validFrom         DateTime
  validUntil        DateTime
  paymentConditions String?
  snapshot          Json
  reason            String
  createdBy         String
  creator           User         @relation("ChinaOfferRevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now())

  currentFor         ChinaOffer?         @relation("ChinaOfferCurrentRevision")
  sourcePurchases    Purchase[]
  customerQuotations CustomerQuotation[]
  reservations       OfferReservation[]

  @@unique([offerId, revisionNumber])
  @@index([organizationId, offerId, createdAt])
}

model ChinaOfferStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerId        String
  offer          ChinaOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  fromStatus     String?
  toStatus       String
  reason         String?
  actorId        String
  actor          User         @relation("ChinaOfferStatusActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([organizationId, offerId, createdAt])
}

model OfferReservation {
  id                    String             @id @default(uuid())
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id])
  offerId               String
  offer                 ChinaOffer         @relation(fields: [offerId], references: [id])
  sourceOfferRevisionId String
  sourceOfferRevision   ChinaOfferRevision @relation(fields: [sourceOfferRevisionId], references: [id], onDelete: Restrict)
  clientId              String
  client                Client             @relation(fields: [clientId], references: [id])
  dossierId             String?            @unique
  dossier               Dossier?           @relation(fields: [dossierId], references: [id])
  quantity              Int                @default(1)
  status                String             @default("active")
  expiresAt             DateTime?
  releasedAt            DateTime?
  releaseReason         String?
  createdBy             String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  purchase              Purchase?

  @@index([organizationId, status, expiresAt])
  @@index([offerId, status])
  @@index([sourceOfferRevisionId])
  @@index([clientId, createdAt])
}

// ──────────────────────────────────────────────
// Dossier & Vehicle Models
// ──────────────────────────────────────────────

enum DossierType {
  VEHICLE_SALE_CIF
  VEHICLE_SALE_DDP
  SHIPPING_ONLY
}

model Dossier {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  reference        String // CA-2026-00001
  type             DossierType       @default(VEHICLE_SALE_CIF)
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id])
  vehicleRequestId String?           @unique
  vehicleRequest   VehicleRequest?   @relation(fields: [vehicleRequestId], references: [id])
  orderId          String?           @unique
  order            Order?            @relation(fields: [orderId], references: [id])
  offerReservation OfferReservation?
  status           String            @default("offerSelected")
  workflowVersion  Int               @default(2)
  forwarderSupplierId String?
  forwarderSupplier Partner?         @relation("DossierForwarder", fields: [forwarderSupplierId], references: [id], onDelete: Restrict)
  vehicleBookingVehicleId String?
  vehicleBookingDate DateTime?
  vehicleBookingNote String?
  upgradedFromType  DossierType?
  upgradedAt        DateTime?
  cifPrice          Decimal?          @db.Decimal(12, 2)
  ddpPrice          Decimal?          @db.Decimal(12, 2)
  priceCurrency     String?
  priceLockedAt     DateTime?
  dutyOverrideAmount Decimal?         @db.Decimal(12, 2)
  dutyOverrideJustification String?
  salesUserId      String
  salesUser        User              @relation("DossierSalesUser", fields: [salesUserId], references: [id])
  opsUserId        String?
  opsUser          User?             @relation("DossierOperationsUser", fields: [opsUserId], references: [id])
  chinaResponsibleId String?
  chinaResponsible   User?           @relation("DossierChinaResponsible", fields: [chinaResponsibleId], references: [id])
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  history             DossierStatusHistory[]
  dossierVehicles     DossierVehicle[]
  purchases           Purchase[]
  invoices            Invoice[]
  paymentPlans        PaymentPlan[]
  payments            Payment[]
  customerDeposits    CustomerDeposit[]
  costs               Cost[]
  documents           DossierDocumentAsset[]
  notes               DossierNote[]
  customsFiles        CustomsFile[]
  tasks               Task[]
  checkpointEvidence  DossierCheckpointEvidence[]
  gedLinks            GedDocumentLink[]
  supplierLinks       SupplierDossierLink[]
  contracts           Contract[]
  financeTransactions FinanceTransaction[]
  customerQuotations  CustomerQuotation[]
  calls               CallSession[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, openedAt])
  @@index([organizationId, type, openedAt])
  @@index([clientId])
  @@index([salesUserId])
  @@index([opsUserId])
  @@index([chinaResponsibleId])
  @@index([forwarderSupplierId])
}

model DossierVehicle {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now())

  @@unique([dossierId, vehicleId])
  @@index([vehicleId])
}

model DossierStatusHistory {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id])
  fromStatus String?
  toStatus   String
  changedBy  String
  user       User     @relation(fields: [changedBy], references: [id])
  comment    String?
  createdAt  DateTime @default(now())

  @@index([dossierId, createdAt])
  @@index([changedBy])
}

model Vehicle {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  vin               String?            @unique
  brand             String
  model             String
  year              Int?
  mileage           Int?
  condition         String?
  trim              String?
  bodyType          String?
  drivetrain        String?
  displacement      String?
  steeringSide      String?
  interiorColor     String?
  warranty          String?
  equipment         Json?
  purchasePrice     Decimal?           @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  currency          String?
  status            String             @default("available")
  rejectionReason   String?
  rejectedAt        DateTime?
  rejectedBy        String?
  lengthCm          Decimal?            @map("length_cm") @db.Decimal(10, 2)
  widthCm           Decimal?            @map("width_cm") @db.Decimal(10, 2)
  heightCm          Decimal?            @map("height_cm") @db.Decimal(10, 2)
  weightKg          Decimal?            @map("weight_kg") @db.Decimal(10, 2)
  brandLookupId     String?
  modelLookupId     String?
  bodyTypeLookupId  String?
  acquisitionType   String // "stock" | "client_request"
  supplierId        String?
  supplier          Partner?           @relation("VehicleSupplier", fields: [supplierId], references: [id])
  currentLocationId String?
  currentLocation   WarehouseLocation? @relation(fields: [currentLocationId], references: [id])
  acquiredAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  specs              VehicleSpec?
  photos             VehiclePhoto[]
  dossierVehicles    DossierVehicle[]
  candidates         VehicleCandidate[]
  orderItems         OrderItem[]
  reservations       Reservation[]
  stockMovements     StockMovement[]
  purchases          Purchase[]
  shipmentVehicles   ShipmentVehicle[]
  customsFiles       CustomsFile[]
  customsFileLinks   CustomsFileVehicle[]
  checkpointEvidence DossierCheckpointEvidence[]
  gedLinks           GedDocumentLink[]

  @@index([organizationId, status, createdAt])
  @@index([supplierId])
  @@index([currentLocationId])
  @@index([brandLookupId])
  @@index([modelLookupId])
}

model VehicleSpec {
  id           String  @id @default(uuid())
  vehicleId    String  @unique
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id])
  engine       String?
  fuelType     String?
  transmission String?
  color        String?
  seats        Int?
  doors        Int?
  power        String?
  description  String?
  engineLookupId       String?
  fuelTypeLookupId     String?
  transmissionLookupId String?
  colorLookupId        String?
}

model VehicleLookupValue {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // BRAND | MODEL | ENGINE | TRANSMISSION | FUEL_TYPE | COLOR | BODY_TYPE
  value          String
  normalizedValue String
  parentId       String?
  parent         VehicleLookupValue?  @relation("VehicleLookupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
