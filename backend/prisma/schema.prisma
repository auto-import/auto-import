// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Identity & Tenancy Models
// ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String
  country   String?
  city      String?
  phone     String?
  email     String?
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices               Office[]
  users                 User[]
  warehouses            Warehouse[]
  roles                 Role[]
  prospects             Prospect[]
  clients               Client[]
  vehicles              Vehicle[]
  dossiers              Dossier[]
  orders                Order[]
  vehicleRequests       VehicleRequest[]
  partners              Partner[]
  purchases             Purchase[]
  chinaOffers           ChinaOffer[]
  offerReservations     OfferReservation[]
  commerceSequences     CommerceSequence[]
  vehicleReservations   Reservation[]
  shipments             Shipment[]
  customsFiles          CustomsFile[]
  customerDeposits      CustomerDeposit[]
  stockMovements        StockMovement[]
  tasks                 Task[]
  auditLogs             AuditLog[]
  contactPoints         ContactPoint[]
  companyChannels       CompanyChannel[]
  callSessions          CallSession[]
  agentPresences        AgentPresence[]
  whatsappConversations WhatsappConversation[]
  whatsappMessages      WhatsappMessage[]
  webhookInboxes        WebhookInbox[]
  appointments          Appointment[]
  crmNotes              CrmNote[]
  prospectStatusHistory ProspectStatusHistory[]

  @@index([status])
}

model Office {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  country        String?
  city           String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  users User[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  officeId       String?
  office         Office?      @relation(fields: [officeId], references: [id])
  firstName      String
  lastName       String
  email          String       @unique
  passwordHash   String
  status         String       @default("active")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userRoles             UserRole[]
  refreshSessions       RefreshSession[]
  salesDossiers         Dossier[]               @relation("DossierSalesUser")
  operationsDossiers    Dossier[]               @relation("DossierOperationsUser")
  dossierStatusChanges  DossierStatusHistory[]
  prospectActivities    ProspectActivity[]
  assignedProspects     Prospect[]
  assignedClients       Client[]                @relation("ClientAssignee")
  prospectStatusChanges ProspectStatusHistory[]
  crmNotes              CrmNote[]
  dispatchedCalls       CallSession[]           @relation("CallDispatcher")
  handledCalls          CallSession[]           @relation("CallHandler")
  callEvents            CallEvent[]
  dispatchedAssignments CallAssignment[]        @relation("AssignmentDispatcher")
  assignmentsFrom       CallAssignment[]        @relation("AssignmentFrom")
  assignmentsTo         CallAssignment[]        @relation("AssignmentTo")
  presence              AgentPresence?
  assignedConversations WhatsappConversation[]  @relation("ConversationAssignee")
  appointments          Appointment[]           @relation("AppointmentAssignee")
  uploadedFiles         FileAsset[]
  stockMovements        StockMovement[]
  assignedRequests      VehicleRequest[]
  createdOrders         Order[]
  orderStatusChanges    OrderStatusHistory[]
  reservations          Reservation[]
  confirmedPurchases    Purchase[]              @relation("PurchaseConfirmer")
  uploadedDocuments     BusinessDocument[]
  assignedTasks         Task[]                  @relation("TaskAssignee")
  createdTasks          Task[]                  @relation("TaskCreator")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([organizationId, status])
  @@index([officeId])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  userAgent String?
  ipAddress String?

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Role {
  id             String        @id @default(uuid())
  organizationId String? // null = platform-level role (Super Admin SaaS)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  scope          String        @default("tenant") // "platform" | "tenant"
  description    String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId, scope])
}

model Permission {
  id          String  @id @default(uuid())
  resource    String // "dossiers", "finance", "vehicles"...
  action      String // "read", "write", "approve", "delete"
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ──────────────────────────────────────────────
// CRM Models
// ──────────────────────────────────────────────

model Prospect {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  firstName         String
  lastName          String
  phone             String?
  email             String?
  wilaya            String?
  source            String?
  status            String            @default("new")
  qualification     LeadQualification @default(UNCLASSIFIED)
  assignedTo        String?
  assignee          User?             @relation(fields: [assignedTo], references: [id])
  notes             String?
  lastInteractionAt DateTime?
  nextActionAt      DateTime?
  convertedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  activities            ProspectActivity[]
  client                Client?
  vehicleRequests       VehicleRequest[]
  orders                Order[]
  deposits              CustomerDeposit[]
  contactPoints         ContactPoint[]
  calls                 CallSession[]
  whatsappConversations WhatsappConversation[]
  appointments          Appointment[]
  tasks                 Task[]
  crmNotes              CrmNote[]
  statusHistory         ProspectStatusHistory[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assignedTo])
}

model ProspectActivity {
  id           String   @id @default(uuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String
  title        String
  description  String?
  activityDate DateTime
  createdAt    DateTime @default(now())

  @@index([prospectId, activityDate])
  @@index([userId])
}

model Client {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  prospectId        String?      @unique
  prospect          Prospect?    @relation(fields: [prospectId], references: [id])
  firstName         String
  lastName          String
  phone             String?
  email             String?
  passportNumber    String?
  passportExpiry    DateTime?
  nationality       String?
  address           String?
  status            String       @default("active")
  assignedTo        String?
  assignee          User?        @relation("ClientAssignee", fields: [assignedTo], references: [id])
  lastInteractionAt DateTime?
  nextActionAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  dossiers              Dossier[]
  orders                Order[]
  vehicleRequests       VehicleRequest[]
  invoices              Invoice[]
  deposits              CustomerDeposit[]
  contactPoints         ContactPoint[]
  calls                 CallSession[]
  whatsappConversations WhatsappConversation[]
  appointments          Appointment[]
  tasks                 Task[]
  crmNotes              CrmNote[]
  offerReservations     OfferReservation[]

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, assignedTo])
}

enum LeadQualification {
  HOT
  WARM
  COLD
  UNCLASSIFIED
}

enum ContactPointKind {
  PHONE
  EMAIL
}

enum CompanyChannelKind {
  VOICE
  WHATSAPP
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallState {
  RINGING
  QUEUED
  ASSIGNED
  FORWARDED
  ANSWERED
  COMPLETED
  MISSED
  FAILED
}

enum CallAssignmentStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  FAILED
}

enum AgentPresenceStatus {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

enum PresenceSource {
  MANUAL
  PROVIDER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageContentType {
  TEXT
  TEMPLATE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
}

enum MessageDeliveryStatus {
  RECEIVED
  SIMULATED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model ContactPoint {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            ContactPointKind
  displayValue    String
  normalizedValue String
  whatsappEnabled Boolean          @default(false)
  prospectId      String?
  prospect        Prospect?        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferred       Boolean          @default(false)
  verified        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, kind, normalizedValue])
  @@index([prospectId])
  @@index([clientId])
}

model CompanyChannel {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel          CompanyChannelKind
  displayName      String
  normalizedNumber String
  providerKey      String
  active           Boolean            @default(true)
  queueName        String             @default("default")
  routingConfig    Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  calls         CallSession[]
  conversations WhatsappConversation[]
  webhookEvents WebhookInbox[]

  @@unique([organizationId, channel, normalizedNumber])
  @@unique([providerKey, channel, normalizedNumber])
  @@index([normalizedNumber, channel, active])
}

model CallSession {
  id                 String         @id @default(uuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId          String
  channel            CompanyChannel @relation(fields: [channelId], references: [id])
  providerKey        String
  providerCallId     String
  direction          CallDirection
  companyNumber      String
  externalNumber     String
  prospectId         String?
  prospect           Prospect?      @relation(fields: [prospectId], references: [id])
  clientId           String?
  client             Client?        @relation(fields: [clientId], references: [id])
  dispatcherId       String?
  dispatcher         User?          @relation("CallDispatcher", fields: [dispatcherId], references: [id])
  handlingEmployeeId String?
  handlingEmployee   User?          @relation("CallHandler", fields: [handlingEmployeeId], references: [id])
  state              CallState      @default(RINGING)
  receivedAt         DateTime       @default(now())
  queuedAt           DateTime?
  answeredAt         DateTime?
  completedAt        DateTime?
  durationSeconds    Int?
  waitingSeconds     Int?
  outcome            String?
  notes              String?
  nextAction         String?
  nextActionAt       DateTime?
  missedReason       String?
  failureReason      String?
  dispositionedAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  events        CallEvent[]
  assignments   CallAssignment[]
  busyPresences AgentPresence[]
  callbackTask  Task?            @relation("CallbackTask")

  @@unique([organizationId, providerKey, providerCallId])
  @@index([organizationId, state, queuedAt])
  @@index([organizationId, handlingEmployeeId, receivedAt])
  @@index([prospectId, receivedAt])
  @@index([clientId, receivedAt])
}

model CallEvent {
  id              String      @id @default(uuid())
  callSessionId   String
  callSession     CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  providerEventId String?
  state           CallState
  actorUserId     String?
  actorUser       User?       @relation(fields: [actorUserId], references: [id])
  metadata        Json?
  occurredAt      DateTime
  createdAt       DateTime    @default(now())

  @@unique([callSessionId, providerEventId])
  @@index([callSessionId, occurredAt, id])
}

model CallAssignment {
  id            String               @id @default(uuid())
  callSessionId String
  callSession   CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  dispatcherId  String
  dispatcher    User                 @relation("AssignmentDispatcher", fields: [dispatcherId], references: [id])
  fromUserId    String?
  fromUser      User?                @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User                 @relation("AssignmentTo", fields: [toUserId], references: [id])
  status        CallAssignmentStatus @default(REQUESTED)
  reason        String?
  requestedAt   DateTime             @default(now())
  resolvedAt    DateTime?

  @@index([callSessionId, requestedAt])
  @@index([toUserId, status])
}

model AgentPresence {
  id              String              @id @default(uuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          AgentPresenceStatus @default(OFFLINE)
  source          PresenceSource      @default(MANUAL)
  currentCallId   String?
  currentCall     CallSession?        @relation(fields: [currentCallId], references: [id])
  lastHeartbeatAt DateTime
  updatedAt       DateTime            @updatedAt

  @@index([organizationId, status, lastHeartbeatAt])
}

model WhatsappConversation {
  id                     String         @id @default(uuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId              String
  channel                CompanyChannel @relation(fields: [channelId], references: [id])
  providerKey            String
  providerConversationId String?
  externalNumber         String
  prospectId             String?
  prospect               Prospect?      @relation(fields: [prospectId], references: [id])
  clientId               String?
  client                 Client?        @relation(fields: [clientId], references: [id])
  assignedTo             String?
  assignee               User?          @relation("ConversationAssignee", fields: [assignedTo], references: [id])
  lastMessageAt          DateTime?
  closedAt               DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  messages WhatsappMessage[]
  tasks    Task[]

  @@unique([organizationId, channelId, externalNumber])
  @@index([organizationId, lastMessageAt])
  @@index([prospectId])
  @@index([clientId])
}

model WhatsappMessage {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      WhatsappConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerKey       String
  providerMessageId String
  direction         MessageDirection
  contentType       MessageContentType    @default(TEXT)
  text              String?
  status            MessageDeliveryStatus
  replyToId         String?
  replyTo           WhatsappMessage?      @relation("WhatsappReply", fields: [replyToId], references: [id])
  replies           WhatsappMessage[]     @relation("WhatsappReply")
  occurredAt        DateTime
  sentAt            DateTime?
  receivedAt        DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([organizationId, providerKey, providerMessageId])
  @@index([conversationId, occurredAt, id])
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     String
  assignee       User              @relation("AppointmentAssignee", fields: [assignedTo], references: [id])
  prospectId     String?
  prospect       Prospect?         @relation(fields: [prospectId], references: [id])
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id])
  title          String
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  outcome        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, assignedTo, scheduledStart])
  @@index([prospectId, scheduledStart])
  @@index([clientId, scheduledStart])
}

model CrmNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  content        String
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([prospectId, occurredAt, id])
  @@index([clientId, occurredAt, id])
}

model ProspectStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  changedBy      String?
  user           User?        @relation(fields: [changedBy], references: [id])
  fromStatus     String?
  toStatus       String
  reason         String?
  occurredAt     DateTime     @default(now())

  @@index([prospectId, occurredAt, id])
  @@index([organizationId, occurredAt])
}

model WebhookInbox {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId       String
  channel         CompanyChannel          @relation(fields: [channelId], references: [id])
  providerKey     String
  providerEventId String
  eventType       String
  payloadHash     String
  metadata        Json?
  status          WebhookProcessingStatus @default(RECEIVED)
  retryCount      Int                     @default(0)
  lastError       String?
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  updatedAt       DateTime                @updatedAt

  @@unique([organizationId, providerKey, providerEventId])
  @@index([status, receivedAt])
  @@index([channelId, receivedAt])
}

model Partner {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String // "supplier" | "carrier" | "other"
  country        String?
  city           String?
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  website        String?
  paymentTerms   String?
  deliveryTerms  String?
  specialties    String[]     @default([])
  notes          String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  suppliedVehicles Vehicle[]    @relation("VehicleSupplier")
  purchases        Purchase[]
  chinaOffers      ChinaOffer[]
  shipments        Shipment[]

  @@index([organizationId, type, status])
}

model CommerceSequence {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

model ChinaOffer {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  supplierId         String
  supplier           Partner      @relation(fields: [supplierId], references: [id])
  reference          String
  brand              String
  model              String
  version            String?
  year               Int?
  condition          String
  mileage            Int?
  specification      Json
  purchasePrice      Decimal?     @db.Decimal(12, 2)
  cifPrice           Decimal      @db.Decimal(12, 2)
  ddpPrice           Decimal      @db.Decimal(12, 2)
  currency           String
  validFrom          DateTime
  validUntil         DateTime
  availableQuantity  Int
  reservedQuantity   Int          @default(0)
  estimatedDelayDays Int?
  status             String       @default("available")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  reservations OfferReservation[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, validUntil])
  @@index([organizationId, supplierId, createdAt])
}

model OfferReservation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  offerId        String
  offer          ChinaOffer   @relation(fields: [offerId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  dossierId      String?      @unique
  dossier        Dossier?     @relation(fields: [dossierId], references: [id])
  quantity       Int          @default(1)
  status         String       @default("active")
  expiresAt      DateTime?
  releasedAt     DateTime?
  releaseReason  String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchase       Purchase?

  @@index([organizationId, status, expiresAt])
  @@index([offerId, status])
  @@index([clientId, createdAt])
}

// ──────────────────────────────────────────────
// Dossier & Vehicle Models
// ──────────────────────────────────────────────

enum DossierType {
  VEHICLE_SALE_CIF
  VEHICLE_SALE_DDP
  SHIPPING_ONLY
}

model Dossier {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  reference        String // CA-2026-00001
  type             DossierType       @default(VEHICLE_SALE_CIF)
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id])
  vehicleRequestId String?           @unique
  vehicleRequest   VehicleRequest?   @relation(fields: [vehicleRequestId], references: [id])
  orderId          String?           @unique
  order            Order?            @relation(fields: [orderId], references: [id])
  offerReservation OfferReservation?
  status           String            @default("offerSelected")
  salesUserId      String
  salesUser        User              @relation("DossierSalesUser", fields: [salesUserId], references: [id])
  opsUserId        String?
  opsUser          User?             @relation("DossierOperationsUser", fields: [opsUserId], references: [id])
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  history         DossierStatusHistory[]
  dossierVehicles DossierVehicle[]
  purchases       Purchase[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, openedAt])
  @@index([organizationId, type, openedAt])
  @@index([clientId])
  @@index([salesUserId])
  @@index([opsUserId])
}

model DossierVehicle {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now())

  @@unique([dossierId, vehicleId])
  @@index([vehicleId])
}

model DossierStatusHistory {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id])
  fromStatus String?
  toStatus   String
  changedBy  String
  user       User     @relation(fields: [changedBy], references: [id])
  comment    String?
  createdAt  DateTime @default(now())

  @@index([dossierId, createdAt])
  @@index([changedBy])
}

model Vehicle {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  vin               String?            @unique
  brand             String
  model             String
  year              Int?
  mileage           Int?
  condition         String?
  purchasePrice     Decimal?           @db.Decimal(12, 2)
  sellingPrice      Decimal?           @db.Decimal(12, 2)
  currency          String?
  status            String             @default("available")
  acquisitionType   String // "stock" | "client_request"
  supplierId        String?
  supplier          Partner?           @relation("VehicleSupplier", fields: [supplierId], references: [id])
  currentLocationId String?
  currentLocation   WarehouseLocation? @relation(fields: [currentLocationId], references: [id])
  acquiredAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  specs            VehicleSpec?
  photos           VehiclePhoto[]
  dossierVehicles  DossierVehicle[]
  candidates       VehicleCandidate[]
  orderItems       OrderItem[]
  reservations     Reservation[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  shipmentVehicles ShipmentVehicle[]
  customsFiles     CustomsFile[]

  @@index([organizationId, status, createdAt])
  @@index([supplierId])
  @@index([currentLocationId])
}

model VehicleSpec {
  id           String  @id @default(uuid())
  vehicleId    String  @unique
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id])
  engine       String?
  fuelType     String?
  transmission String?
  color        String?
  seats        Int?
  doors        Int?
  power        String?
  description  String?
}

model FileAsset {
  id           String   @id @default(uuid())
  storageKey   String
  originalName String
  mimeType     String
  size         BigInt
  category     String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  vehiclePhotos     VehiclePhoto[]
  customsDocuments  CustomsDocument[]
  businessDocuments BusinessDocument[]
  uploadedByUser    User               @relation(fields: [uploadedBy], references: [id])

  @@index([uploadedBy, createdAt])
}

model VehiclePhoto {
  id        String    @id @default(uuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  fileId    String
  file      FileAsset @relation(fields: [fileId], references: [id])
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([vehicleId, sortOrder])
  @@index([fileId])
}

// ──────────────────────────────────────────────
// Warehouse & Stock Models
// ──────────────────────────────────────────────

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String?
  country        String?
  city           String?
  address        String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  locations WarehouseLocation[]

  @@index([organizationId, status])
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  name        String?
  status      String    @default("active")

  vehicles      Vehicle[]
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo   StockMovement[] @relation("StockMovementTo")

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
}

model StockMovement {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id])
  fromLocationId String?
  fromLocation   WarehouseLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     WarehouseLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id])
  performedBy    String
  user           User               @relation(fields: [performedBy], references: [id])
  type           String
  reason         String?
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())

  @@index([organizationId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedBy])
}

// ──────────────────────────────────────────────
// Request & Order Models
// ──────────────────────────────────────────────

model VehicleRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  assignedTo     String?
  assignee       User?        @relation(fields: [assignedTo], references: [id])
  brand          String?
  model          String?
  minYear        Int?
  maxYear        Int?
  budgetMin      Decimal?     @db.Decimal(12, 2)
  budgetMax      Decimal?     @db.Decimal(12, 2)
  currency       String?
  preferredColor String?
  requirements   String?
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidates VehicleCandidate[]
  dossier    Dossier?
  purchase   Purchase?

  @@index([organizationId, status, createdAt])
  @@index([prospectId])
  @@index([clientId])
  @@index([assignedTo])
}

model VehicleCandidate {
  id               String         @id @default(uuid())
  vehicleRequestId String
  vehicleRequest   VehicleRequest @relation(fields: [vehicleRequestId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  proposedPrice    Decimal?       @db.Decimal(12, 2)
  currency         String?
  status           String         @default("proposed") // proposed | validated | rejected
  notes            String?
  presentedAt      DateTime?
  validatedAt      DateTime?
  purchase         Purchase?

  @@unique([vehicleRequestId, vehicleId])
  @@index([vehicleId])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNumber    String
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  createdBy      String
  creator        User         @relation(fields: [createdBy], references: [id])
  status         String       @default("draft")
  subtotal       Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  currency       String
  orderDate      DateTime     @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items            OrderItem[]
  history          OrderStatusHistory[]
  reservations     Reservation[]
  dossier          Dossier?
  invoices         Invoice[]
  paymentPlans     PaymentPlan[]
  deposits         CustomerDeposit[]
  shipmentVehicles ShipmentVehicle[]
  purchases        Purchase[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, orderDate])
  @@index([clientId])
  @@index([prospectId])
  @@index([createdBy])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  invoiceItems InvoiceItem[]

  @@index([vehicleId])
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  changedBy  String
  user       User     @relation(fields: [changedBy], references: [id])
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedBy])
}

model Reservation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  reservedBy     String
  user           User         @relation(fields: [reservedBy], references: [id])
  status         String       @default("active")
  reservedAt     DateTime     @default(now())
  expiresAt      DateTime?
  releasedAt     DateTime?
  releaseReason  String?

  @@index([organizationId, status, expiresAt])
  @@index([vehicleId, status])
  @@index([orderId])
  @@index([reservedBy])
}

// ──────────────────────────────────────────────
// Procurement, Shipping & Customs Models
// ──────────────────────────────────────────────

model Purchase {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  purchaseNumber     String
  supplierId         String
  supplier           Partner           @relation(fields: [supplierId], references: [id])
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])
  purchasePrice      Decimal           @db.Decimal(12, 2)
  currency           String
  status             String            @default("pending")
  purchaseDate       DateTime?
  vehicleRequestId   String?           @unique
  vehicleRequest     VehicleRequest?   @relation(fields: [vehicleRequestId], references: [id])
  candidateId        String?           @unique
  candidate          VehicleCandidate? @relation(fields: [candidateId], references: [id])
  dossierId          String?
  dossier            Dossier?          @relation(fields: [dossierId], references: [id])
  orderId            String?
  order              Order?            @relation(fields: [orderId], references: [id])
  confirmedBy        String?
  confirmer          User?             @relation("PurchaseConfirmer", fields: [confirmedBy], references: [id])
  supplierSnapshot   Json?
  vehicleSnapshot    Json?
  offerReservationId String?           @unique
  offerReservation   OfferReservation? @relation(fields: [offerReservationId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payments SupplierPayment[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, status, purchaseDate])
  @@index([supplierId])
  @@index([vehicleId])
  @@index([dossierId])
  @@index([orderId])
}

model SupplierPayment {
  id            String    @id @default(uuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  currency      String
  paymentMethod String?
  reference     String?
  status        String    @default("pending")
  paymentDate   DateTime?
  notes         String?

  @@index([purchaseId, status])
}

model Shipment {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  shipmentNumber   String       @unique
  carrierPartnerId String?
  carrierPartner   Partner?     @relation(fields: [carrierPartnerId], references: [id])
  blNumber         String?
  vesselName       String?
  containerNumber  String?
  departurePort    String?
  arrivalPort      String?
  etd              DateTime?
  eta              DateTime?
  status           String       @default("pending")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vehicles     ShipmentVehicle[]
  costs        ShippingCost[]
  customsFiles CustomsFile[]

  @@index([organizationId, status, etd])
  @@index([carrierPartnerId])
}

model ShipmentVehicle {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])

  @@unique([shipmentId, vehicleId])
  @@index([vehicleId])
  @@index([orderId])
}

model ShippingCost {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  description String?
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

model CustomsFile {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  reference         String       @unique
  shipmentId        String?
  shipment          Shipment?    @relation(fields: [shipmentId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?     @relation(fields: [vehicleId], references: [id])
  status            String       @default("open")
  declarationNumber String?
  customsValue      Decimal?     @db.Decimal(12, 2)
  customsAmount     Decimal?     @db.Decimal(12, 2)
  currency          String?
  openedAt          DateTime     @default(now())
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  documents CustomsDocument[]

  @@index([organizationId, status, openedAt])
  @@index([shipmentId])
  @@index([vehicleId])
}

model CustomsDocument {
  id            String      @id @default(uuid())
  customsFileId String
  customsFile   CustomsFile @relation(fields: [customsFileId], references: [id])
  fileId        String
  file          FileAsset   @relation(fields: [fileId], references: [id])
  documentType  String?
  status        String      @default("pending")
  uploadedAt    DateTime    @default(now())

  @@index([customsFileId])
  @@index([fileId])
}

model BusinessDocument {
  id           String    @id @default(uuid())
  fileId       String
  file         FileAsset @relation(fields: [fileId], references: [id])
  uploadedBy   String
  user         User      @relation(fields: [uploadedBy], references: [id])
  documentType String?
  title        String?
  description  String?
  entityType   String // "dossier" | "client" | "vehicle" ...
  entityId     String
  createdAt    DateTime  @default(now())

  @@index([uploadedBy, createdAt])
  @@index([entityType, entityId])
}

// ──────────────────────────────────────────────
// Finance Models
// ──────────────────────────────────────────────

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  status        String    @default("draft")
  subtotal      Decimal   @db.Decimal(12, 2)
  tax           Decimal   @default(0) @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  currency      String
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@index([orderId, status])
  @@index([clientId])
}

model InvoiceItem {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  description String?
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  total       Decimal    @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([orderItemId])
}

model PaymentPlan {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String
  status      String   @default("active")
  createdAt   DateTime @default(now())

  installments PaymentInstallment[]

  @@index([orderId, status])
}

model PaymentInstallment {
  id                String      @id @default(uuid())
  paymentPlanId     String
  paymentPlan       PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  installmentNumber Int
  amount            Decimal     @db.Decimal(12, 2)
  paidAmount        Decimal     @default(0) @db.Decimal(12, 2)
  dueDate           DateTime
  status            String      @default("pending")

  payments Payment[]

  @@unique([paymentPlanId, installmentNumber])
  @@index([status, dueDate])
}

model Payment {
  id            String              @id @default(uuid())
  invoiceId     String?
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id])
  installmentId String?
  installment   PaymentInstallment? @relation(fields: [installmentId], references: [id])
  amount        Decimal             @db.Decimal(12, 2)
  currency      String
  paymentMethod String?
  reference     String?
  status        String              @default("pending")
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime            @default(now())

  @@index([invoiceId])
  @@index([installmentId])
  @@index([status, paymentDate])
}

model CustomerDeposit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prospectId     String?
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  currency       String
  paymentMethod  String?
  reference      String?
  status         String       @default("pending")
  paymentDate    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status, createdAt])
  @@index([prospectId])
  @@index([clientId])
  @@index([orderId])
}

// ──────────────────────────────────────────────
// Support & Operations Models
// ──────────────────────────────────────────────

model Task {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id])
  assignedTo        String
  assignee          User                  @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdBy         String
  creator           User                  @relation("TaskCreator", fields: [createdBy], references: [id])
  title             String
  description       String?
  priority          String                @default("normal")
  status            String                @default("todo")
  dueDate           DateTime?
  relatedType       String?
  relatedId         String?
  prospectId        String?
  prospect          Prospect?             @relation(fields: [prospectId], references: [id])
  clientId          String?
  client            Client?               @relation(fields: [clientId], references: [id])
  conversationId    String?
  conversation      WhatsappConversation? @relation(fields: [conversationId], references: [id])
  callbackForCallId String?               @unique
  callbackForCall   CallSession?          @relation("CallbackTask", fields: [callbackForCallId], references: [id])
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([organizationId, status, dueDate])
  @@index([assignedTo, status])
  @@index([createdBy])
  @@index([prospectId, status, dueDate])
  @@index([clientId, status, dueDate])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String
  eventType String
  subject   String?
  content   String
  channel   String   @default("in_app")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  notifications Notification[]
}

model Notification {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  type        String
  title       String
  content     String?
  channel     String                @default("in_app")
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime              @default(now())

  @@index([userId, readAt, createdAt])
  @@index([templateId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
