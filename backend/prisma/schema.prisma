  lastFour         String?
  status           String       @default("ACTIVE")
  createdBy        String
  creator          User         @relation("SupplierBankCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy        String
  updater          User         @relation("SupplierBankUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
