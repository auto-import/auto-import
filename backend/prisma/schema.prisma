// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Identity & Tenancy Models
// ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String
  country   String?
  city      String?
  phone     String?
  email     String?
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices         Office[]
  users           User[]
  warehouses      Warehouse[]
  roles           Role[]
  prospects       Prospect[]
  clients         Client[]
  vehicles        Vehicle[]
  dossiers        Dossier[]
  orders          Order[]
  vehicleRequests VehicleRequest[]
  partners        Partner[]
}

model Office {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  country        String?
  city           String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  users User[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  officeId       String?
  office         Office?      @relation(fields: [officeId], references: [id])
  firstName      String
  lastName       String
  email          String       @unique
  passwordHash   String
  status         String       @default("active")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userRoles UserRole[]
}

model Role {
  id             String        @id @default(uuid())
  organizationId String? // null = platform-level role (Super Admin SaaS)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  scope          String        @default("tenant") // "platform" | "tenant"
  description    String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  resource    String // "dossiers", "finance", "vehicles"...
  action      String // "read", "write", "approve", "delete"
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ──────────────────────────────────────────────
// CRM Models
// ──────────────────────────────────────────────

model Prospect {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  firstName      String
  lastName       String
  phone          String?
  email          String?
  wilaya         String?
  source         String?
  status         String       @default("new")
  assignedTo     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities ProspectActivity[]
  client     Client?
}

model ProspectActivity {
  id           String   @id @default(uuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id])
  userId       String
  type         String
  title        String
  description  String?
  activityDate DateTime
  createdAt    DateTime @default(now())
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prospectId     String?      @unique
  prospect       Prospect?    @relation(fields: [prospectId], references: [id])
  firstName      String
  lastName       String
  phone          String?
  email          String?
  passportNumber String?
  passportExpiry DateTime?
  nationality    String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dossiers Dossier[]
  orders   Order[]
}

model Partner {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String // "supplier" | "carrier" | "other"
  country        String?
  city           String?
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ──────────────────────────────────────────────
// Dossier & Vehicle Models
// ──────────────────────────────────────────────

enum DossierType {
  VEHICLE_SALE_CIF
  VEHICLE_SALE_DDP
  SHIPPING_ONLY
}

model Dossier {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  reference        String          @unique // CA-2026-0001
  type             DossierType     @default(VEHICLE_SALE_CIF)
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  vehicleRequestId String?         @unique
  vehicleRequest   VehicleRequest? @relation(fields: [vehicleRequestId], references: [id])
  orderId          String?         @unique
  order            Order?          @relation(fields: [orderId], references: [id])
  status           String          @default("prospection")
  salesUserId      String
  opsUserId        String?
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  history         DossierStatusHistory[]
  dossierVehicles DossierVehicle[]
}

model DossierVehicle {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now())

  @@unique([dossierId, vehicleId])
}

model DossierStatusHistory {
  id         String   @id @default(uuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id])
  fromStatus String?
  toStatus   String
  changedBy  String
  comment    String?
  createdAt  DateTime @default(now())
}

model Vehicle {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  vin               String?      @unique
  brand             String
  model             String
  year              Int?
  mileage           Int?
  condition         String?
  purchasePrice     Decimal?     @db.Decimal(12, 2)
  sellingPrice      Decimal?     @db.Decimal(12, 2)
  currency          String?
  status            String       @default("available")
  acquisitionType   String // "stock" | "client_request"
  supplierId        String?
  currentLocationId String?
  acquiredAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  specs           VehicleSpec?
  photos          VehiclePhoto[]
  dossierVehicles DossierVehicle[]
  candidates      VehicleCandidate[]
  orderItems      OrderItem[]
  reservations    Reservation[]
}

model VehicleSpec {
  id           String  @id @default(uuid())
  vehicleId    String  @unique
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id])
  engine       String?
  fuelType     String?
  transmission String?
  color        String?
  seats        Int?
  doors        Int?
  power        String?
  description  String?
}

model FileAsset {
  id           String   @id @default(uuid())
  storageKey   String
  originalName String
  mimeType     String
  size         BigInt
  category     String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  vehiclePhotos     VehiclePhoto[]
  customsDocuments  CustomsDocument[]
  businessDocuments BusinessDocument[]
}

model VehiclePhoto {
  id        String    @id @default(uuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  fileId    String
  file      FileAsset @relation(fields: [fileId], references: [id])
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

// ──────────────────────────────────────────────
// Warehouse & Stock Models
// ──────────────────────────────────────────────

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String?
  country        String?
  city           String?
  address        String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  locations WarehouseLocation[]
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  name        String?
  status      String    @default("active")
}

model StockMovement {
  id             String   @id @default(uuid())
  vehicleId      String
  fromLocationId String?
  toLocationId   String?
  performedBy    String
  type           String
  reason         String?
  createdAt      DateTime @default(now())
}

// ──────────────────────────────────────────────
// Request & Order Models
// ──────────────────────────────────────────────

model VehicleRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prospectId     String?
  clientId       String?
  assignedTo     String?
  brand          String?
  model          String?
  minYear        Int?
  maxYear        Int?
  budgetMin      Decimal?     @db.Decimal(12, 2)
  budgetMax      Decimal?     @db.Decimal(12, 2)
  currency       String?
  preferredColor String?
  requirements   String?
  status         String       @default("open")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidates VehicleCandidate[]
  dossier    Dossier?
}

model VehicleCandidate {
  id               String         @id @default(uuid())
  vehicleRequestId String
  vehicleRequest   VehicleRequest @relation(fields: [vehicleRequestId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  proposedPrice    Decimal?       @db.Decimal(12, 2)
  currency         String?
  status           String         @default("proposed") // proposed | validated | rejected
  notes            String?
  presentedAt      DateTime?
  validatedAt      DateTime?

  @@unique([vehicleRequestId, vehicleId])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNumber    String       @unique
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  prospectId     String?
  createdBy      String
  status         String       @default("draft")
  subtotal       Decimal      @db.Decimal(12, 2)
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  currency       String
  orderDate      DateTime     @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items        OrderItem[]
  history      OrderStatusHistory[]
  reservations Reservation[]
  dossier      Dossier?
  invoices     Invoice[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  changedBy  String
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())
}

model Reservation {
  id         String    @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  reservedBy String
  status     String    @default("active")
  reservedAt DateTime  @default(now())
  expiresAt  DateTime?
  releasedAt DateTime?
}

// ──────────────────────────────────────────────
// Procurement, Shipping & Customs Models
// ──────────────────────────────────────────────

model Purchase {
  id             String    @id @default(uuid())
  purchaseNumber String    @unique
  supplierId     String
  vehicleId      String
  purchasePrice  Decimal   @db.Decimal(12, 2)
  currency       String
  status         String    @default("pending")
  purchaseDate   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments SupplierPayment[]
}

model SupplierPayment {
  id            String    @id @default(uuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  currency      String
  paymentMethod String?
  reference     String?
  status        String    @default("pending")
  paymentDate   DateTime?
  notes         String?
}

model Shipment {
  id               String    @id @default(uuid())
  shipmentNumber   String    @unique
  carrierPartnerId String?
  blNumber         String?
  vesselName       String?
  containerNumber  String?
  departurePort    String?
  arrivalPort      String?
  etd              DateTime?
  eta              DateTime?
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicles ShipmentVehicle[]
  costs    ShippingCost[]
}

model ShipmentVehicle {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  vehicleId  String
  orderId    String?
}

model ShippingCost {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String
  description String?
  createdAt   DateTime @default(now())
}

model CustomsFile {
  id                String    @id @default(uuid())
  reference         String    @unique
  shipmentId        String?
  vehicleId         String?
  status            String    @default("open")
  declarationNumber String?
  customsValue      Decimal?  @db.Decimal(12, 2)
  customsAmount     Decimal?  @db.Decimal(12, 2)
  currency          String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents CustomsDocument[]
}

model CustomsDocument {
  id            String      @id @default(uuid())
  customsFileId String
  customsFile   CustomsFile @relation(fields: [customsFileId], references: [id])
  fileId        String
  file          FileAsset   @relation(fields: [fileId], references: [id])
  documentType  String?
  status        String      @default("pending")
  uploadedAt    DateTime    @default(now())
}

model BusinessDocument {
  id           String    @id @default(uuid())
  fileId       String
  file         FileAsset @relation(fields: [fileId], references: [id])
  uploadedBy   String
  documentType String?
  title        String?
  description  String?
  entityType   String // "dossier" | "client" | "vehicle" ...
  entityId     String
  createdAt    DateTime  @default(now())
}

// ──────────────────────────────────────────────
// Finance Models
// ──────────────────────────────────────────────

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  clientId      String
  status        String    @default("draft")
  subtotal      Decimal   @db.Decimal(12, 2)
  tax           Decimal   @default(0) @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  currency      String
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  orderItemId String?
  description String?
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
}

model PaymentPlan {
  id          String   @id @default(uuid())
  orderId     String
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String
  status      String   @default("active")
  createdAt   DateTime @default(now())

  installments PaymentInstallment[]
}

model PaymentInstallment {
  id                String      @id @default(uuid())
  paymentPlanId     String
  paymentPlan       PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  installmentNumber Int
  amount            Decimal     @db.Decimal(12, 2)
  paidAmount        Decimal     @default(0) @db.Decimal(12, 2)
  dueDate           DateTime
  status            String      @default("pending")

  payments Payment[]
}

model Payment {
  id            String              @id @default(uuid())
  invoiceId     String?
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id])
  installmentId String?
  installment   PaymentInstallment? @relation(fields: [installmentId], references: [id])
  amount        Decimal             @db.Decimal(12, 2)
  currency      String
  paymentMethod String?
  reference     String?
  status        String              @default("pending")
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
}

model CustomerDeposit {
  id            String    @id @default(uuid())
  prospectId    String?
  clientId      String?
  orderId       String?
  amount        Decimal   @db.Decimal(12, 2)
  currency      String
  paymentMethod String?
  reference     String?
  status        String    @default("pending")
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
}

// ──────────────────────────────────────────────
// Support & Operations Models
// ──────────────────────────────────────────────

model Task {
  id          String    @id @default(uuid())
  assignedTo  String
  createdBy   String
  title       String
  description String?
  priority    String    @default("normal")
  status      String    @default("todo")
  dueDate     DateTime?
  relatedType String?
  relatedId   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String
  eventType String
  subject   String?
  content   String
  channel   String   @default("in_app")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  notifications Notification[]
}

model Notification {
  id          String                @id @default(uuid())
  userId      String
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  type        String
  title       String
  content     String?
  channel     String                @default("in_app")
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime              @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}
