// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Identity & Tenancy Models
// ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      String
  country   String?
  city      String?
  phone     String?
  email     String?
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices               Office[]
  users                 User[]
  warehouses            Warehouse[]
  roles                 Role[]
  prospects             Prospect[]
  clients               Client[]
  vehicles              Vehicle[]
  dossiers              Dossier[]
  orders                Order[]
  vehicleRequests       VehicleRequest[]
  partners              Partner[]
  purchases             Purchase[]
  chinaOffers           ChinaOffer[]
  chinaOfferVehicles    ChinaOfferVehicle[]
  offerReservations     OfferReservation[]
  commerceSequences     CommerceSequence[]
  vehicleReservations   Reservation[]
  shipments             Shipment[]
  customsFiles          CustomsFile[]
  customerDeposits      CustomerDeposit[]
  stockMovements        StockMovement[]
  tasks                 Task[]
  auditLogs             AuditLog[]
  contactPoints         ContactPoint[]
  companyChannels       CompanyChannel[]
  callSessions          CallSession[]
  agentPresences        AgentPresence[]
  whatsappConversations WhatsappConversation[]
  whatsappMessages      WhatsappMessage[]
  webhookInboxes        WebhookInbox[]
  appointments          Appointment[]
  crmNotes              CrmNote[]
  prospectStatusHistory ProspectStatusHistory[]
  crmReferenceValues    CrmReferenceValue[]
  prospectConversions   ProspectConversion[]
  gedCategories         GedCategory[]
  gedDocumentTypes      GedDocumentType[]
  gedDocuments          GedDocument[]
  gedDocumentVersions   GedDocumentVersion[]
  gedDocumentLinks      GedDocumentLink[]
  gedValidationHistory  GedValidationHistory[]
  dossierChecklistRules DossierChecklistRule[]
  supplierContacts      SupplierContact[]
  supplierBankAccounts  SupplierBankAccount[]
  supplierIncidents     SupplierIncident[]
  supplierDossierLinks  SupplierDossierLink[]
  offerRevisions        ChinaOfferRevision[]
  offerStatusHistory    ChinaOfferStatusHistory[]
  customerQuotations    CustomerQuotation[]
  quotationRevisions    CustomerQuotationRevision[]
  contracts             Contract[]
  treasuryAccounts      TreasuryAccount[]
  financeTransactions   FinanceTransaction[]
  invoices              Invoice[]
  paymentPlans          PaymentPlan[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  supplierPayments      SupplierPayment[]
  exchangeRates         ExchangeRate[]
  costs                 Cost[]
  fileAssets            FileAsset[]
  dossierDocuments      DossierDocumentAsset[]
  dossierNotes          DossierNote[]
  settings              OrganizationSettings?
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  userAvatars           UserAvatar[]
  offerPhotos           OfferPhoto[]
  checkpointEvidence    DossierCheckpointEvidence[]
  integrationConfigs    IntegrationConfig[]
  brandingLogo          OrganizationBrandingLogo?
  vehicleLookupValues   VehicleLookupValue[]
  containerPresets      ContainerPreset[]
  vehicleDutyRates      VehicleDutyRate[]
  localDeliveryRates    LocalDeliveryRate[]

  @@index([status])
}

model Office {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  country        String?
  city           String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  users User[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  officeId       String?
  office         Office?      @relation(fields: [officeId], references: [id])
  firstName      String
  lastName       String
  email          String       @unique
  passwordHash   String
  status         String       @default("active")
  lastLoginAt    DateTime?
  locale         String       @default("fr")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userRoles                 UserRole[]
  refreshSessions           RefreshSession[]
  salesDossiers             Dossier[]                   @relation("DossierSalesUser")
  operationsDossiers        Dossier[]                   @relation("DossierOperationsUser")
  chinaResponsibleDossiers  Dossier[]                   @relation("DossierChinaResponsible")
  dossierStatusChanges      DossierStatusHistory[]
  prospectActivities        ProspectActivity[]
  assignedProspects         Prospect[]
  assignedClients           Client[]                    @relation("ClientAssignee")
  prospectStatusChanges     ProspectStatusHistory[]
  prospectConversions       ProspectConversion[]        @relation("ProspectConversionActor")
  archivedProspects         Prospect[]                  @relation("ProspectArchivedBy")
  archivedClients           Client[]                    @relation("ClientArchivedBy")
  crmNotes                  CrmNote[]
  dispatchedCalls           CallSession[]               @relation("CallDispatcher")
  handledCalls              CallSession[]               @relation("CallHandler")
  recordedCalls             CallSession[]               @relation("CallRecorder")
  callEvents                CallEvent[]
  dispatchedAssignments     CallAssignment[]            @relation("AssignmentDispatcher")
  assignmentsFrom           CallAssignment[]            @relation("AssignmentFrom")
  assignmentsTo             CallAssignment[]            @relation("AssignmentTo")
  presence                  AgentPresence?
  assignedConversations     WhatsappConversation[]      @relation("ConversationAssignee")
  appointments              Appointment[]               @relation("AppointmentAssignee")
  uploadedFiles             FileAsset[]
  stockMovements            StockMovement[]
  assignedRequests          VehicleRequest[]
  createdOrders             Order[]
  orderStatusChanges        OrderStatusHistory[]
  reservations              Reservation[]
  confirmedPurchases        Purchase[]                  @relation("PurchaseConfirmer")
  uploadedDocuments         BusinessDocument[]
  assignedTasks             Task[]                      @relation("TaskAssignee")
  createdTasks              Task[]                      @relation("TaskCreator")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  confirmedPayments         Payment[]                   @relation("PaymentActor")
  confirmedSupplierPayments SupplierPayment[]           @relation("SupplierPaymentActor")
  createdExchangeRates      ExchangeRate[]              @relation("ExchangeRateCreator")
  recordedCosts             Cost[]                      @relation("CostActor")
  dossierDocuments          DossierDocumentAsset[]      @relation("DossierDocUploader")
  dossierNotes              DossierNote[]               @relation("DossierNoteAuthor")
  shipmentStatusChanges     ShipmentStatusHistory[]     @relation("ShipmentStatusUser")
  customsStatusChanges      CustomsStatusHistory[]      @relation("CustomsStatusUser")
  responsibleCustomsFiles   CustomsFile[]               @relation("CustomsResponsibleUser")
  avatar                    UserAvatar?
  checkpointEvidence        DossierCheckpointEvidence[] @relation("CheckpointEvidenceUploader")
  integrationUpdates        IntegrationConfig[]         @relation("IntegrationConfigUpdater")
  createdGedDocuments       GedDocument[]               @relation("GedDocumentCreator")
  archivedGedDocuments      GedDocument[]               @relation("GedDocumentArchiver")
  uploadedGedVersions       GedDocumentVersion[]        @relation("GedVersionUploader")
  gedValidationActions      GedValidationHistory[]      @relation("GedValidationActor")
  createdGedLinks           GedDocumentLink[]           @relation("GedLinkCreator")
  createdChecklistRules     DossierChecklistRule[]      @relation("ChecklistRuleCreator")
  createdSupplierContacts   SupplierContact[]           @relation("SupplierContactCreator")
  createdSupplierBanks      SupplierBankAccount[]       @relation("SupplierBankCreator")
  updatedSupplierBanks      SupplierBankAccount[]       @relation("SupplierBankUpdater")
  reportedSupplierIncidents SupplierIncident[]          @relation("SupplierIncidentReporter")
  resolvedSupplierIncidents SupplierIncident[]          @relation("SupplierIncidentResolver")
  createdSupplierLinks      SupplierDossierLink[]       @relation("SupplierDossierLinkCreator")
  createdOfferRevisions     ChinaOfferRevision[]        @relation("ChinaOfferRevisionCreator")
  offerStatusChanges        ChinaOfferStatusHistory[]   @relation("ChinaOfferStatusActor")
  createdContracts          Contract[]                  @relation("ContractCreator")
  validatedFinanceEntries   FinanceTransaction[]        @relation("FinanceTransactionValidator")
  createdFinanceEntries     FinanceTransaction[]        @relation("FinanceTransactionCreator")
  createdCustomerQuotations CustomerQuotation[]         @relation("CustomerQuotationCreator")
  createdQuotationRevisions CustomerQuotationRevision[] @relation("CustomerQuotationRevisionCreator")

  @@index([organizationId, status])
  @@index([officeId])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  userAgent String?
  ipAddress String?

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Role {
  id             String        @id @default(uuid())
  organizationId String? // null = platform-level role (Super Admin SaaS)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  scope          String        @default("tenant") // "platform" | "tenant"
  description    String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId, scope])
}

model Permission {
  id          String  @id @default(uuid())
  resource    String // "dossiers", "finance", "vehicles"...
  action      String // "read", "write", "approve", "delete"
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ──────────────────────────────────────────────
// CRM Models
// ──────────────────────────────────────────────

model Prospect {
  id                     String             @id @default(uuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id])
  firstName              String
  lastName               String
  phone                  String?
  phoneNormalized        String?
  email                  String?
  wilaya                 String?
  city                   String?
  source                 String?
  legacySource           String?
  entryChannelId         String?
  entryChannel           CrmReferenceValue? @relation("ProspectEntryChannel", fields: [entryChannelId], references: [id])
  marketingSourceId      String?
  marketingSource        CrmReferenceValue? @relation("ProspectMarketingSource", fields: [marketingSourceId], references: [id])
  countryId              String?
  country                CrmReferenceValue? @relation("ProspectCountry", fields: [countryId], references: [id])
  status                 String             @default("new")
  crmStatus              String?
  crmOutcome             String?
  reconciliationRequired Boolean            @default(false)
  qualification          LeadQualification  @default(UNCLASSIFIED)
  assignedTo             String?
  assignee               User?              @relation(fields: [assignedTo], references: [id])
  notes                  String?
  needType               String             @default("VEHICLE")
  shippingDescription    String?
  shippingCargoType      String?
  shippingDestination    String?
  shippingRequirements   String?
  lastInteractionAt      DateTime?
  nextActionAt           DateTime?
  nextAction             String?
  convertedAt            DateTime?
  archivedAt             DateTime?
  archivedById           String?
  archivedBy             User?              @relation("ProspectArchivedBy", fields: [archivedById], references: [id])
  archiveReason          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  activities            ProspectActivity[]
  client                Client?
  vehicleRequests       VehicleRequest[]
  orders                Order[]
  deposits              CustomerDeposit[]
  contactPoints         ContactPoint[]
  calls                 CallSession[]
  whatsappConversations WhatsappConversation[]
  appointments          Appointment[]
  tasks                 Task[]
  crmNotes              CrmNote[]
  statusHistory         ProspectStatusHistory[]
  conversions           ProspectConversion[]
  gedLinks              GedDocumentLink[]
  contracts             Contract[]
  financeTransactions   FinanceTransaction[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, assignedTo])
  @@index([organizationId, crmStatus, createdAt])
  @@index([organizationId, qualification, createdAt])
  @@index([organizationId, entryChannelId, createdAt])
  @@index([organizationId, marketingSourceId, createdAt])
  @@index([organizationId, needType, createdAt])
  @@index([organizationId, nextActionAt])
  @@index([organizationId, phoneNormalized])
  @@index([archivedById])
}

model ProspectActivity {
  id           String   @id @default(uuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String
  title        String
  description  String?
  activityDate DateTime
  createdAt    DateTime @default(now())

  @@index([prospectId, activityDate])
  @@index([userId])
}

model Client {
  id                   String             @id @default(uuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  prospectId           String?            @unique
  prospect             Prospect?          @relation(fields: [prospectId], references: [id])
  firstName            String
  lastName             String
  phone                String?
  phoneNormalized      String?
  email                String?
  passportNumber       String?
  passportEncrypted    String?
  passportLookupHash   String?
  ninEncrypted         String?
  ninLookupHash        String?
  identityDocumentType String?
  identityIssueCountry String?
  identityIssueDate    DateTime?
  passportExpiry       DateTime?
  nationality          String?
  countryId            String?
  country              CrmReferenceValue? @relation("ClientCountry", fields: [countryId], references: [id])
  nationalityCountryId String?
  nationalityCountry   CrmReferenceValue? @relation("ClientNationality", fields: [nationalityCountryId], references: [id])
  address              String?
  status               String             @default("active")
  assignedTo           String?
  assignee             User?              @relation("ClientAssignee", fields: [assignedTo], references: [id])
  lastInteractionAt    DateTime?
  nextActionAt         DateTime?
  archivedAt           DateTime?
  archivedById         String?
  archivedBy           User?              @relation("ClientArchivedBy", fields: [archivedById], references: [id])
  archiveReason        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  dossiers              Dossier[]
  orders                Order[]
  vehicleRequests       VehicleRequest[]
  invoices              Invoice[]
  deposits              CustomerDeposit[]
  contactPoints         ContactPoint[]
  calls                 CallSession[]
  whatsappConversations WhatsappConversation[]
  appointments          Appointment[]
  tasks                 Task[]
  crmNotes              CrmNote[]
  offerReservations     OfferReservation[]
  paymentPlans          PaymentPlan[]
  payments              Payment[]
  documents             DossierDocumentAsset[]
  conversions           ProspectConversion[]
  gedLinks              GedDocumentLink[]
  contracts             Contract[]
  financeTransactions   FinanceTransaction[]
  customerQuotations    CustomerQuotation[]

  @@unique([organizationId, ninLookupHash])
  @@unique([organizationId, passportLookupHash])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, assignedTo])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, status, createdAt])
  @@index([archivedById])
}

/// Tenant-configurable CRM values. `kind` is intentionally a string so adding
/// channels, sources and countries does not require a destructive enum change.
model CrmReferenceValue {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String
  code           String
  labelFr        String
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prospectsAsEntryChannel    Prospect[] @relation("ProspectEntryChannel")
  prospectsAsMarketingSource Prospect[] @relation("ProspectMarketingSource")
  prospectsAsCountry         Prospect[] @relation("ProspectCountry")
  clientsAsCountry           Client[]   @relation("ClientCountry")
  clientsAsNationality       Client[]   @relation("ClientNationality")

  @@unique([organizationId, kind, code])
  @@index([organizationId, kind, active, sortOrder])
}

/// Canonical append-only conversion lineage. Client.prospectId remains a
/// temporary backward-compatible projection for the first conversion only.
model ProspectConversion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String       @unique
  prospect       Prospect     @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  convertedBy    String?
  actor          User?        @relation("ProspectConversionActor", fields: [convertedBy], references: [id], onDelete: Restrict)
  convertedAt    DateTime     @default(now())

  @@index([organizationId, clientId, convertedAt])
  @@index([convertedBy])
}

enum LeadQualification {
  HOT
  WARM
  COLD
  UNCLASSIFIED
}

enum ContactPointKind {
  PHONE
  EMAIL
}

enum CompanyChannelKind {
  VOICE
  WHATSAPP
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallState {
  RINGING
  QUEUED
  ASSIGNED
  FORWARDED
  ANSWERED
  COMPLETED
  MISSED
  FAILED
}

enum CallAssignmentStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  FAILED
}

enum AgentPresenceStatus {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

enum PresenceSource {
  MANUAL
  PROVIDER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageContentType {
  TEXT
  TEMPLATE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
}

enum MessageDeliveryStatus {
  RECEIVED
  SIMULATED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model ContactPoint {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            ContactPointKind
  displayValue    String
  normalizedValue String
  whatsappEnabled Boolean          @default(false)
  prospectId      String?
  prospect        Prospect?        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferred       Boolean          @default(false)
  verified        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, kind, normalizedValue])
  @@index([prospectId])
  @@index([clientId])
}

model CompanyChannel {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel          CompanyChannelKind
  displayName      String
  normalizedNumber String
  providerKey      String
  active           Boolean            @default(true)
  queueName        String             @default("default")
  routingConfig    Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  calls         CallSession[]
  conversations WhatsappConversation[]
  webhookEvents WebhookInbox[]

  @@unique([organizationId, channel, normalizedNumber])
  @@unique([providerKey, channel, normalizedNumber])
  @@index([normalizedNumber, channel, active])
}

model CallSession {
  id                 String         @id @default(uuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId          String
  channel            CompanyChannel @relation(fields: [channelId], references: [id])
  providerKey        String
  providerCallId     String
  direction          CallDirection
  companyNumber      String
  externalNumber     String
  prospectId         String?
  prospect           Prospect?      @relation(fields: [prospectId], references: [id])
  clientId           String?
  client             Client?        @relation(fields: [clientId], references: [id])
  dispatcherId       String?
  dispatcher         User?          @relation("CallDispatcher", fields: [dispatcherId], references: [id])
  handlingEmployeeId String?
  handlingEmployee   User?          @relation("CallHandler", fields: [handlingEmployeeId], references: [id])
  recordedById       String?
  recordedBy         User?          @relation("CallRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  dossierId          String?
  dossier            Dossier?       @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  subject            String?
  state              CallState      @default(RINGING)
  receivedAt         DateTime       @default(now())
  queuedAt           DateTime?
  answeredAt         DateTime?
  completedAt        DateTime?
  durationSeconds    Int?
  waitingSeconds     Int?
  outcome            String?
  notes              String?
  nextAction         String?
  nextActionAt       DateTime?
  missedReason       String?
  failureReason      String?
  dispositionedAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  events        CallEvent[]
  assignments   CallAssignment[]
  busyPresences AgentPresence[]
  callbackTask  Task?            @relation("CallbackTask")

  @@unique([organizationId, providerKey, providerCallId])
  @@index([organizationId, state, queuedAt])
  @@index([organizationId, handlingEmployeeId, receivedAt])
  @@index([prospectId, receivedAt])
  @@index([clientId, receivedAt])
  @@index([dossierId, receivedAt])
  @@index([recordedById, receivedAt])
}

model CallEvent {
  id              String      @id @default(uuid())
  callSessionId   String
  callSession     CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  providerEventId String?
  state           CallState
  actorUserId     String?
  actorUser       User?       @relation(fields: [actorUserId], references: [id])
  metadata        Json?
  occurredAt      DateTime
  createdAt       DateTime    @default(now())

  @@unique([callSessionId, providerEventId])
  @@index([callSessionId, occurredAt, id])
}

model CallAssignment {
  id            String               @id @default(uuid())
  callSessionId String
  callSession   CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  dispatcherId  String
  dispatcher    User                 @relation("AssignmentDispatcher", fields: [dispatcherId], references: [id])
  fromUserId    String?
  fromUser      User?                @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User                 @relation("AssignmentTo", fields: [toUserId], references: [id])
  status        CallAssignmentStatus @default(REQUESTED)
  reason        String?
  requestedAt   DateTime             @default(now())
  resolvedAt    DateTime?

  @@index([callSessionId, requestedAt])
  @@index([toUserId, status])
}

model AgentPresence {
  id              String              @id @default(uuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          AgentPresenceStatus @default(OFFLINE)
  source          PresenceSource      @default(MANUAL)
  currentCallId   String?
  currentCall     CallSession?        @relation(fields: [currentCallId], references: [id])
  lastHeartbeatAt DateTime
  updatedAt       DateTime            @updatedAt

  @@index([organizationId, status, lastHeartbeatAt])
}

model WhatsappConversation {
  id                     String         @id @default(uuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId              String
  channel                CompanyChannel @relation(fields: [channelId], references: [id])
  providerKey            String
  providerConversationId String?
  externalNumber         String
  prospectId             String?
  prospect               Prospect?      @relation(fields: [prospectId], references: [id])
  clientId               String?
  client                 Client?        @relation(fields: [clientId], references: [id])
  assignedTo             String?
  assignee               User?          @relation("ConversationAssignee", fields: [assignedTo], references: [id])
  lastMessageAt          DateTime?
  closedAt               DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  messages WhatsappMessage[]
  tasks    Task[]

  @@unique([organizationId, channelId, externalNumber])
  @@index([organizationId, lastMessageAt])
  @@index([prospectId])
  @@index([clientId])
}

model WhatsappMessage {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      WhatsappConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerKey       String
  providerMessageId String
  direction         MessageDirection
  contentType       MessageContentType    @default(TEXT)
  text              String?
  status            MessageDeliveryStatus
  replyToId         String?
  replyTo           WhatsappMessage?      @relation("WhatsappReply", fields: [replyToId], references: [id])
  replies           WhatsappMessage[]     @relation("WhatsappReply")
  occurredAt        DateTime
  sentAt            DateTime?
  receivedAt        DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([organizationId, providerKey, providerMessageId])
