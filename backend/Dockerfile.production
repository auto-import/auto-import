# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies
RUN apt-get update \
  && apt-get install --yes --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY contracts/package.json contracts/index.js contracts/index.d.ts ./contracts/
COPY backend/package.json backend/package-lock.json ./backend/
WORKDIR /app/backend
RUN --mount=type=cache,target=/root/.npm npm ci

FROM dependencies AS build
WORKDIR /app
COPY contracts ./contracts
COPY backend ./backend
WORKDIR /app/backend
RUN npx prisma generate && npm run build

FROM build AS migrate
ENV NODE_ENV=production
CMD ["npx", "prisma", "migrate", "deploy"]

FROM build AS production-dependencies
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install --yes --no-install-recommends fonts-dejavu-core openssl \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=3000 PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
WORKDIR /app
COPY --from=production-dependencies --chown=node:node /app/backend/node_modules ./backend/node_modules
COPY --from=build --chown=node:node /app/backend/dist ./backend/dist
COPY --from=build --chown=node:node /app/backend/package.json ./backend/package.json
COPY --from=build --chown=node:node /app/backend/scripts/erp-v2-phase1-authenticated-smoke.mjs ./backend/scripts/erp-v2-phase1-authenticated-smoke.mjs
COPY --from=build --chown=node:node /app/contracts ./contracts
WORKDIR /app/backend
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "dist/src/main.js"]
